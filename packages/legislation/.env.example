# ===========================================================================
# kern/legislation — reading the law, and the rates a law refers to
# ===========================================================================
# Every variable here is read by the config file named above its group, and already has a default
# there — which is why each is listed commented out, and why the default is not repeated here: the
# config file is the one place it is written down. Uncomment one only to change it.
#
# `php artisan kern:env` collects this file together with the application's and every other
# installed package's. tests/Feature/Config/ConfigKeysTest.php fails when this package's config
# reads a variable this file does not name.

# --- config/sources.php ---
# Where a source document is fetched from, and the ceilings one fetch runs under. A source is the
# evidence behind every number this system produces, so a fetch that is too large, too slow or
# redirected too often fails rather than storing something partial.
# SOURCES_FETCH_MAX_BYTES=
# SOURCES_FETCH_MAX_REDIRECTS=
# SOURCES_FETCH_TIMEOUT_SECONDS=
# Which filesystem disk the fetched originals are kept on, and under which prefix. The disk is
# defined by the application (config/filesystems.php); this only chooses between those it defines.
# SOURCES_STORAGE_DISK=
# SOURCES_STORAGE_PREFIX=
# The legislation portal's SOAP service, and how long one request to it may take.
# LEGISLATIE_SOAP_URL=
# LEGISLATIE_FETCH_TIMEOUT_SECONDS=
# The BNR daily reference rates, and the TLS curves its server will negotiate. The curve list is not
# decoration: without it the handshake fails outright against that host.
# BNR_DAILY_XML_URL=
# BNR_TLS_CURVES=
# How a rate is stored and checked. The scale is the number of decimals a rate keeps — changing it
# changes every number computed from a rate — and the tolerance is how far a re-fetched rate may
# differ from the stored one before the pair is reported instead of accepted.
# FX_DECIMAL_SCALE=
# FX_VERIFICATION_TOLERANCE=

# --- config/legislation.php ---
# How long reading one consolidation of a law — download, parse, index — may take. The Horizon
# supervisor and the queue's retry_after both read it, so raising it here raises all three.
# LEGISLATION_QUEUE_TIMEOUT_SECONDS=
# Reading a law from legislatie.just.ro: its queue, the pause before a consolidation the portal did
# not serve is tried again, how many chunks are embedded at once, and the earliest year the ingest
# task offers.
# LEGISLATION_QUEUE=
# LEGISLATION_SYNC_RETRY_SECONDS=
# LEGISLATION_EMBEDDING_BATCH=
# LEGISLATION_MIN_YEAR=

# --- config/ai/legislation.php ---
# Reading the law for the fiscal values: which model reads, which reads after it to catch a
# misreading, how many paragraphs of a chapter travel with a question, and from which year the law
# is read. The prompts are here so wording can be tuned without a deployment.
# LEGISLATION_AI_MODEL=
# LEGISLATION_AI_SECOND_MODEL=
# LEGISLATION_AI_MAX_TOKENS=
# LEGISLATION_AI_TIMEOUT_SECONDS=
# LEGISLATION_AI_ARTICLES=
# LEGISLATION_AI_PARAGRAPHS=
# LEGISLATION_AI_FROM_YEAR=
# LEGISLATION_PROMPT_SYSTEM=
# LEGISLATION_PROMPT_INSTRUCTION=
# LEGISLATION_PROMPT_INSTRUCTION_TOGETHER=

# --- config/ai/embeddings.php ---
# Semantic search over the law. The model runs inside the processing service, not through an
# external API: the corpus is public legislation, but a question asked of it can carry personal
# context, and self-hosting means neither leaves the machine.
#
# Off by default. An installation whose processing image predates the embedding dependencies must
# keep failing loudly rather than start throwing connection errors inside a backfill because a
# default changed under it.
# RETRIEVAL_EMBEDDING_ENABLED=
# Generous on purpose: the very first call downloads the weights and builds an ONNX session. Later
# calls are milliseconds.
# RETRIEVAL_EMBEDDING_TIMEOUT_SECONDS=
# RETRIEVAL_EMBEDDING_BATCH_SIZE=
# These must agree with the processing service's own EMBEDDING_MODEL_ID / EMBEDDING_DIMENSION and
# with the vector(N) on source_section_chunks, or vectors land in a space nothing can search.
# RETRIEVAL_EMBEDDING_MODEL=
# RETRIEVAL_EMBEDDING_DIMENSION=
