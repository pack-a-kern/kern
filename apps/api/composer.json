{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "kern/api",
    "type": "project",
    "description": "TaxOS Rom\u00e2nia \u2014 Laravel 13 application (modular monolith: Identity, Subjects, Wallet, Ledger, Documents, TaxKnowledge, TaxEngine, Declarations, Spv, Notifications, Audit).",
    "keywords": [
        "laravel",
        "kern"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-bcmath": "*",
        "ext-intl": "*",
        "ext-pcntl": "*",
        "ext-pdo_pgsql": "*",
        "ext-redis": "*",
        "ext-sodium": "*",
        "inertiajs/inertia-laravel": "^3.3.3",
        "laravel/framework": "^13.23",
        "laravel/horizon": "^5.48.3",
        "laravel/reverb": "^1.11.1",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.35.3",
        "spatie/laravel-permission": "8.3.0",
        "spomky-labs/otphp": "^11.5.0",
        "web-auth/webauthn-lib": "^5.3.8"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7.1",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.11.0",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.31.0",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.1.4",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "pestphp/pest-plugin-phpstan": "^5.2.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install --no-interaction --prefer-dist",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm ci",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.5.10",
            "ext-bcmath": "0",
            "ext-intl": "0",
            "ext-pcntl": "0",
            "ext-pdo_pgsql": "0",
            "ext-redis": "0",
            "ext-sodium": "0"
        },
        "platform-check": false,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
