# ===========================================================================
# kern/documents — uploads, virus scanning, text extraction
# ===========================================================================
# Every variable here is read by the config file named above its group, and already has a default
# there — which is why each is listed commented out, and why the default is not repeated here: the
# config file is the one place it is written down. Uncomment one only to change it.
#
# `php artisan kern:env` collects this file together with the application's and every other
# installed package's. tests/Feature/Config/ConfigKeysTest.php fails when this package's config
# reads a variable this file does not name.

# --- config/objectstore.php ---
# Which filesystem disk every document is written to, encrypted, and the size of the chunks it is
# streamed in. The disk is defined by the application (config/filesystems.php) — point THAT at an
# external S3 or MinIO; this only chooses between the disks it defines.
# OBJECTSTORE_DISK=
# OBJECTSTORE_CHUNK_SIZE=

# --- config/documents.php ---
# The disk unscanned uploads land on. A physically separate bucket, not a folder: a file nothing has
# looked at yet must not be reachable where clean documents are served from, so that a mistake in
# one path cannot serve the other's contents.
# DOCUMENTS_QUARANTINE_DISK=
# The virus scanner's address. `clamav` is the container this repository ships; an installation using
# a scanner it already runs sets the host and port and stops starting that container. There is no way
# to turn scanning off — an upload that cannot be scanned is refused, never accepted unscanned.
# CLAMAV_HOST=
# CLAMAV_PORT=
# How long the scanner may take: to accept the connection, then to answer for one streamed file, and
# how much is sent per write. A scan is INSTREAM, so the whole file crosses this socket.
# CLAMAV_CONNECT_TIMEOUT_SECONDS=
# CLAMAV_STREAM_TIMEOUT_SECONDS=
# CLAMAV_CHUNK_SIZE=
# What an upload may be. Each is a refusal, not a truncation — half a receipt is not a smaller
# receipt, so a file over one of these is rejected with a reason the person can act on.
# DOCUMENTS_MAX_PDF_BYTES=
# DOCUMENTS_MAX_PAGES=
# DOCUMENTS_MAX_IMAGE_BYTES=
# The decompressed pixel count, which is what actually costs memory: a small file can describe a
# very large image, and that is the shape of a decompression bomb.
# DOCUMENTS_MAX_IMAGE_PIXELS=
# The text a document may yield, and how long the extraction service may take to yield it.
# DOCUMENTS_MAX_TEXT_BYTES=
# DOCUMENTS_TEXT_EXTRACTION_TIMEOUT_SECONDS=
# Uploads per person, per window. Sized for someone emptying a folder of receipts, not for a script.
# DOCUMENTS_UPLOAD_RATE_LIMIT_MAX_ATTEMPTS=
# DOCUMENTS_UPLOAD_RATE_LIMIT_DECAY_SECONDS=

# --- config/ai/documents.php ---
# The largest document sent for a model to look at. Below the 15 MB an upload may be: base64 adds a
# third on top, and a gateway's own body limit is usually smaller than either. A document over this
# is not truncated — half a receipt is not a smaller receipt — it is reported as a failed extraction
# and typed in by hand.
# AI_EXTRACTION_MAX_IMAGE_BYTES=
# A ceiling on the *reply*, not a target: a model answering properly emits a hundred tokens of JSON
# and stops. Sized for a reasoning model, which spends the same budget thinking first — at 1024,
# `qwen3-vl:8b-thinking` used the entire allowance on its chain of thought and returned an empty
# answer, which is indistinguishable from a model that could not read the document.
# AI_EXTRACTION_MAX_TOKENS=
# Bounds one document extraction, which is a different order of work — loading a vision model, then
# an image, then generating. Measured 32-56s against a self-hosted 8B vision model. Runs on a queue
# worker, so a long wait costs nobody a loading spinner. Reusing the ping's 10s here would abandon
# every real extraction and misreport the provider as unreachable.
# AI_EXTRACTION_TIMEOUT_SECONDS=
# What the model is told to do. Here rather than in code so wording can be tuned without deploying.
# AI_PROMPT_SYSTEM=
# AI_PROMPT_INSTRUCTION=
# AI_PROMPT_ONLY_RELEVANT_FIELDS=
