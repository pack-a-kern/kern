{
    "name": "kern/documents",
    "description": "A document a tenant owns: uploaded in parts, quarantined, virus-scanned, encrypted at rest, read for its text and - with recorded consent - for its figures.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "illuminate/bus": "^13.0",
        "illuminate/cache": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/filesystem": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "kern/audit": "@dev",
        "kern/platform": "@dev"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.1"
    },
    "autoload": {
        "psr-4": {
            "Kern\\Documents\\": "src/",
            "Kern\\Documents\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kern\\Documents\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kern\\Documents\\DocumentsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "repositories": [
        {
            "type": "path",
            "url": "../*",
            "options": {
                "symlink": true
            }
        }
    ]
}
