# ===========================================================================
# The variables of each installed package are documented by that package, in its own `.env.example`.
# `php artisan kern:env` prints this file followed by all of theirs, which is the whole environment:
#
#     php artisan kern:env > .env
#
# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="Kern"
APP_ENV=production
# Generate with: docker compose run --rm app php artisan key:generate --show
APP_KEY=
# A Laravel debug page renders the entire environment — every password and key below — to whoever
# provoked the error. Debug is opted into for local work, never left on.
APP_DEBUG=false
# Every address the application is actually reached at matters: this one is used for links in mail,
# for the passkey origin, and as the default list of origins allowed to open a WebSocket.
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Where the packages mount the JSON routes they ship. `api` unless something already owns that path;
# every package's endpoints move with it.
KERN_ROUTE_PREFIX=api

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# A new file each day, kept LOG_DAILY_DAYS (14) days, rather than one file that only grows. `info`
# leaves out the debug detail a running installation should not be writing; set `debug` while you are
# chasing something, then set it back.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
# Two roles. The owner creates and alters the tables: the bundled container is created with it, and
# `make migrate` (the `migrate` container) connects as it — nothing else does, and the running
# application never sees its password. DB_USERNAME is the application's own, which `migrate` creates
# and keeps in step: it reads and writes rows, adds to the audit trail without changing it, and owns
# nothing (kern:db:grant-app-role). For a database you already run: DB_HOST, and an owner that has
# CREATEROLE; leave the bundled container out. Generate both passwords with: openssl rand -hex 32
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=kern
DB_OWNER_USERNAME=kern
DB_OWNER_PASSWORD=
DB_USERNAME=kern_app
DB_PASSWORD=
# TLS to the database. The bundled server refuses a connection without it, and compose sets both for
# the containers that call it: verify-full, against the stack's own CA. For a database you already
# run, its own answer — verify-full and the path to its CA inside the containers when it has a
# certificate (docker/tls/trusted is mounted at /run/kern/tls-trusted); `prefer` encrypts without
# checking who answers.
DB_SSLMODE=prefer
DB_SSLROOTCERT=

# ---------------------------------------------------------------------------
# Redis — cache, queue, sessions, broadcasting, rate limiting
# ---------------------------------------------------------------------------
# No database-backed cache, queue or session table: all four go through Redis.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
# Generate with: openssl rand -hex 32. The bundled container requires exactly this password.
REDIS_PASSWORD=
# TLS. The bundled server accepts nothing else, and compose sets both for the containers that use it:
# `tls`, checked against the stack's own CA. For a server you already run: `tls` and the path to its CA
# inside the containers when it has a private one; both empty for a server that speaks no TLS.
REDIS_SCHEME=
REDIS_CA_CERT=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# The Content-Security-Policy on every page — see config/csp.php. `report-only` blocks nothing and logs
# every violation as `csp_violation`; switch to `enforce` once that log is clean. `off` sends none.
CSP_MODE=report-only

CACHE_STORE=redis
QUEUE_CONNECTION=redis

# The Redis key prefix Horizon's own metrics live under.
HORIZON_PREFIX=kern_horizon:
# How long a queued job may run before the worker gives up on it. The AI lane is separate because a
# model call is minutes where an ordinary job is seconds; it must stay above every AI_* timeout.
# HORIZON_DEFAULT_QUEUE_TIMEOUT_SECONDS=
# HORIZON_AI_QUEUE_TIMEOUT_SECONDS=

# ---------------------------------------------------------------------------
# Reverb — the WebSocket broadcaster
# ---------------------------------------------------------------------------
BROADCAST_CONNECTION=reverb
# Generate each with: openssl rand -hex 16
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Where the application PUBLISHES an event — inside the network, so the container's name. The browser
# reaches Reverb through the edge instead, at whatever address served the page.
REVERB_HOST=reverb
REVERB_PORT=8080
# TLS, checked against REVERB_CA_CERT. compose.yaml sets both for the containers that publish, because
# the bundled Reverb speaks nothing else; the system's CAs when the file is empty.
REVERB_SCHEME=https
REVERB_CA_CERT=
# What the Reverb process itself binds. Not an address anything connects to.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Its certificate and key. compose.yaml sets both to the pair docker/certs issues it; empty, it
# listens without TLS.
REVERB_TLS_CERT=
REVERB_TLS_KEY=
# The page origins allowed to open a socket, comma-separated. Reverb compares the HOST only, so these
# are hostnames — `example.test`, `ip`, `localhost` — and a full URL is reduced to its
# host. `Str::is` patterns work: `*.example.test` covers subdomains, `*` allows everything and should
# stay out of production, because this check is what stops a page on another site from opening a
# socket against this one with a visitor's cookies.
#
# Unset it defaults to APP_URL's host, which is wrong the moment the application is served from
# anywhere else — and the failure is quiet: the socket connects, then delivers nothing (code 4009).
REVERB_ALLOWED_ORIGINS=localhost

# ---------------------------------------------------------------------------
# The browser's own copy — baked into the assets when they are BUILT
# ---------------------------------------------------------------------------
# Changing one of these takes effect after the frontend is rebuilt, not on a container restart.
# An installation that pulls its images runs assets CI built, so none of these reaches it: they keep
# their defaults, and the page carries REVERB_APP_KEY itself (resources/views/app.blade.php).
#
# Optional: the page already carries REVERB_APP_KEY. Set, it must equal it. It identifies the
# application to the WebSocket server, the way a Pusher app key does, and is public by design — a
# channel's own authorization is what protects a subject's events, not secrecy of this key.
VITE_REVERB_APP_KEY=
# Left empty the browser uses the host, port and scheme that served the page, which is the only thing
# that is right for every way the site is reached. Set them only for a Reverb on its own hostname.
VITE_REVERB_HOST=
VITE_REVERB_PORT=
VITE_REVERB_SCHEME=
# Which interface palette a person sees before they choose one. Must name an entry in
# resources/js/lib/palette.ts; anything else falls back to kernBlue rather than leaving the app
# unstyled.
VITE_DEFAULT_PALETTE=legacyV16V17

# ---------------------------------------------------------------------------
# Object storage — S3, or anything that speaks it
# ---------------------------------------------------------------------------
# Two buckets on one connection: documents (encrypted before they are written) and quarantine, where
# an upload waits for its virus scan. Separate buckets, not folders, so a mistake in one path cannot
# serve the other's contents.

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# https:// — every document crosses this connection. AWS_CA_CERT names the CA its certificate is signed
# by when that is a private one, as a path inside the containers (the installer copies it to
# docker/tls/trusted, mounted at /run/kern/tls-trusted); empty, the system's CAs.
AWS_ENDPOINT=
AWS_CA_CERT=
AWS_BUCKET=kern-documents
QUARANTINE_BUCKET=kern-quarantine
# Keep this true for MinIO, and for AWS drop it and AWS_ENDPOINT both.
AWS_USE_PATH_STYLE_ENDPOINT=true
# MinIO ignores the region; the AWS SDK insists on having one.
AWS_DEFAULT_REGION=eu-central-1

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
# `log` writes every message into the log file instead of sending it — verification codes included,
# in full, delivered to nobody. Only for an installation with no mail server yet; `kern:health` lists
# mail as not configured while it is. A development stack sends to Mailpit instead
# (compose.dev.yaml), readable at http://localhost:8025.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="Kern"

# ---------------------------------------------------------------------------
# The processing service (apps/processing)
# ---------------------------------------------------------------------------
# Where it answers, and the shared secret both sides require. The service returns 401 without it and
# the application refuses to call it with an empty one, so an unset token fails closed on both ends.
# Generate with: openssl rand -hex 32
#
# Empty with the bundled service: compose.services/python.yaml sets its https:// address and the
# stack's CA for the containers that call it. For one you run elsewhere, its https:// address, and
# PROCESSING_CA_CERT only if its certificate is signed by a private CA, as a path inside the containers.
PROCESSING_URL=
PROCESSING_CA_CERT=
INTERNAL_SERVICE_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Not read by Laravel: the containers, and the ports they publish
# ---------------------------------------------------------------------------
# Everything from here down is read by compose.yaml alone — how much the containers may use, which
# host ports they publish, and the settings of the Python service, which has no Laravel config.

# Which services this installation runs here, rather than pointing at one it already has.
#
# compose.yaml holds the application alone — the edge and the four PHP processes. Each service you
# could instead run elsewhere lives in its own file under compose.services/, and this line is the
# list compose loads. Drop a file from the list and that service is not started, and neither is any
# wait for it; then point the matching variable above at wherever it really runs:
#
#   compose.services/postgres.yaml   ->  DB_HOST
#   compose.services/redis.yaml      ->  REDIS_HOST
#   compose.services/openbao.yaml    ->  OPENBAO_ADDR
#   compose.services/clamav.yaml     ->  CLAMAV_HOST        (a scanner is required either way)
#   compose.services/python.yaml     ->  PROCESSING_URL     (or AI_ENABLED=false)
#   compose.services/browser.yaml    ->  BROWSER_WORKER_URL (or do without SPV automation)
#
# Two things to know before editing it. Setting this variable at all SUPPRESSES compose's automatic
# loading of compose.dev.yaml, so a development list must name it explicitly and last — the
# line below does. And compose.yaml on its own has no database, so an empty or partial list starts a
# stack that cannot boot; the default here is every service, which is the shape to keep unless you
# are deliberately moving one off this machine.
#
# The `.dev.yaml` entries are the development half of a service that may not exist — host ports for
# postgres and redis, uvicorn's --reload for the processing plane. Each must follow its own base
# file, and all of them come out of the list together with it. A production list has neither them
# nor compose.dev.yaml.
COMPOSE_FILE=compose.yaml:compose.services/postgres.yaml:compose.services/postgres.dev.yaml:compose.services/redis.yaml:compose.services/redis.dev.yaml:compose.services/openbao.yaml:compose.services/clamav.yaml:compose.services/python.yaml:compose.services/python.dev.yaml:compose.services/browser.yaml:compose.dev.yaml

# Where the stack's own five images come from (app, edge, processing, browser-worker, certs).
# Both empty: built on this machine from this checkout — `make build`, which is development.
# A registry and a release: pulled, never built. The installer copies all three from the release's
# RELEASE file, and `make update VERSION=1.4.0` moves KERN_VERSION. Not set by hand.
# KERN_IMAGES is the registry and owner the images are published under, e.g. ghcr.io/<owner>.
KERN_IMAGES=
KERN_VERSION=
# The GitHub repository, as owner/repository, whose CI signed them. A pulled image whose signature
# was not made by that repository's CI, at the tag of KERN_VERSION, is refused before it starts
# (scripts/verify-images.sh). Required whenever KERN_IMAGES is set.
KERN_IMAGES_SIGNER=

# Certificates for the services inside the stack — docker/certs issues them all from one private CA
# made on first start, renews each once it has TLS_RENEW_DAYS left (checking every TLS_CHECK_SECONDS),
# and every caller verifies against that CA. Nothing here is a certificate or a key; those live in
# volumes, and no person handles them.
TLS_CERT_DAYS=365
TLS_RENEW_DAYS=30
TLS_CA_DAYS=3650
TLS_CHECK_SECONDS=86400
# The names on the edge's certificate when the site is reached by IP, comma-separated: every address
# people type, and localhost. The installer writes them; unset, localhost alone. A domain served by
# Let's Encrypt (KERN_EDGE_TLS) does not use this certificate.
# TLS_EDGE_NAMES=203.0.113.10,localhost,127.0.0.1

# Which host ports the stack publishes. Postgres, Redis is published only in development
# (compose.dev.yaml) and are not reachable from outside the machine otherwise.
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443

# The address this installation answers on, and how the edge proves it is that address.
#
# Both are commented out, and that is the working default: unset, the edge answers on every address
# this machine has and presents the self-signed pair `make certs` wrote. A browser warns about that
# pair — which is the honest state of a server reached by IP address.
#
# Setting them is how that stops being true, and the two go together: a certificate a browser
# trusts is issued for a *name*, so there has to be one.
#
#   KERN_EDGE_SITE=kern.example.ro
#   KERN_EDGE_TLS=you@example.ro          Let's Encrypt, on first request, renewed by the edge
#
# Other answers for KERN_EDGE_TLS:
#
#   internal                              Caddy's own CA. Renews itself; browsers still warn
#   /etc/caddy/certs/a.crt /a/key         a certificate obtained some other way
#
# ACME needs ports 80 and 443 reachable from the internet for the name above. Behind Cloudflare's
# proxy they are not — Cloudflare answers both — so neither challenge ever reaches this server. The
# answer there is to prove the name through DNS instead, which the two variables below turn on, or a
# Cloudflare Origin certificate pointed at by KERN_EDGE_TLS. docs/INSTALLER-PLAN.md §4 has the full
# table.
# KERN_EDGE_SITE=
# KERN_EDGE_TLS=

# Proving the name through DNS: Caddy writes a record in the zone, the certificate authority reads
# it, and whether a proxy sits in front of this server stops mattering.
#
# The first variable is the whole directive and not just the provider's name, because a Caddyfile
# has no conditionals and an `acme_dns` line with no provider is a configuration error — so "off"
# has to be "this variable is empty". The second is the credential, kept separate so Caddy reads it
# at runtime rather than it being part of the configuration's text. `make install` writes both from
# one question.
#
# Cloudflare is the one provider compiled into the edge image (docker/caddy/Dockerfile): a token for
# any other has nothing to use it. The token is scoped to Zone:DNS:Edit + Zone:Zone:Read on that one
# zone, never a global API key.
#
#   KERN_EDGE_ACME_DNS=acme_dns cloudflare {env.KERN_EDGE_DNS_TOKEN}
#   KERN_EDGE_DNS_TOKEN=
# KERN_EDGE_ACME_DNS=
# KERN_EDGE_DNS_TOKEN=
# The HSTS header, as a whole line, once — and only once — the certificate is one a browser trusts.
# On a self-signed certificate it locks browsers out of the site with no way past the warning. The
# installer writes it for Let's Encrypt; with your own certificate, set it after copying that in:
#
#   KERN_EDGE_HSTS=Strict-Transport-Security max-age=31536000
# KERN_EDGE_HSTS=
# Behind Cloudflare's proxy only: believe the visitor's address Cloudflare sends, from Cloudflare's
# own published ranges and nobody else's. Without these every visitor arrives as one of Cloudflare's
# addresses, and login throttles count them as one. The installer writes them for the Cloudflare
# answer; with your own certificate behind Cloudflare (an Origin certificate), set them yourself:
#
#   KERN_EDGE_TRUSTED_PROXIES=trusted_proxies cloudflare
#   KERN_EDGE_CLIENT_IP_HEADERS=client_ip_headers CF-Connecting-IP
# KERN_EDGE_TRUSTED_PROXIES=
# KERN_EDGE_CLIENT_IP_HEADERS=
POSTGRES_DEV_PORT=5432
REDIS_DEV_PORT=6379
MAILPIT_UI_PORT=8025
VITE_DEV_PORT=5173

# Memory for the queue container, shared by every worker in it. Reading a law holds one consolidation
# (~7.6 MB of HTML) as a DOM, and at 512M the kernel killed that worker mid-page.
QUEUE_MEMORY_LIMIT=2G
PYTHON_API_CPUS=2.00
PYTHON_API_MEMORY=1G

# A private AI endpoint — one on a VPN or a LAN — usually resolves only through the host's
# /etc/hosts, which containers never read: the provider answers from a terminal and is unreachable
# from the application, with nothing in the error to explain why. Setting both halves publishes the
# mapping inside the containers. Leave them unset for a provider with ordinary public DNS.
AI_ENDPOINT_HOST=
AI_ENDPOINT_IP=

# The embedding model, inside the processing service. EMBEDDING_MODEL_ID and EMBEDDING_DIMENSION are
# documented by kern/legislation, which reads the same two variables — one name per value, so the
# application and the service that loads the model cannot disagree.
EMBEDDING_REVISION=main
EMBEDDING_MAX_TOKENS=512
EMBEDDING_BATCH_SIZE=16
# A 118 MB int8 build; needs AVX512-VNNI. On a host without it use model_O4.onnx (235 MB).
EMBEDDING_ONNX_FILE=model_qint8_avx512_vnni.onnx
# E5 mean-pools and wants these prefixes. A symmetric model (bge-m3) uses "cls" and empty prefixes.
EMBEDDING_POOLING=mean
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_PASSAGE_PREFIX="passage: "
# Download the weights at boot rather than on the first request.
EMBEDDING_WARM_ON_STARTUP=false

# How much of a bank statement the reader will take. A current account's five years is comfortably
# under 20 000 rows; beyond these the file is something other than a statement, and is refused before
# anything parses it. The preamble is the lines above the table header that are returned with it —
# the bank, the account, the period.
STATEMENT_PARSE_MAX_ROWS=20000
STATEMENT_PARSE_MAX_FILE_SIZE_BYTES=10485760
STATEMENT_PARSE_MAX_PDF_PAGES=60
STATEMENT_PARSE_MAX_PREAMBLE_ROWS=20
