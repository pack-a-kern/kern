{
    "name": "kern/legislation",
    "description": "Read a law from its official source: every consolidation fetched, dated and parsed, with provision history and hybrid lexical-plus-semantic search over the result.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-dom": "*",
        "illuminate/bus": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/filesystem": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "kern/audit": "@dev",
        "kern/platform": "@dev"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.1"
    },
    "autoload": {
        "psr-4": {
            "Kern\\Legislation\\": "src/",
            "Kern\\Legislation\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kern\\Legislation\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kern\\Legislation\\LegislationServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "repositories": [
        {
            "type": "path",
            "url": "../*",
            "options": {
                "symlink": true
            }
        }
    ]
}
