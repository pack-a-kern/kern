<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>

        <!--
            The addresses and names the suite has no deployment to read them from.

            Every one of these is a value only an operator can know, so no config file invents a
            default for it (a wrong default is a service quietly pointed at the wrong host). A test
            run is the one environment with no operator: without these the container that would
            answer is absent anyway, so what is set here is a plausible name, never a reachable one
            — the doubles the suite binds are what answer.
        -->
        <env name="APP_NAME" value="Kern" force="true"/>
        <env name="APP_URL" value="http://localhost" force="true"/>
        <env name="OBJECTSTORE_DISK" value="s3" force="true"/>
        <env name="DOCUMENTS_QUARANTINE_DISK" value="quarantine" force="true"/>
        <env name="CLAMAV_HOST" value="clamav" force="true"/>
        <env name="OPENBAO_ADDR" value="http://openbao:8200" force="true"/>
        <env name="BROWSER_WORKER_URL" value="http://browser-worker:8090" force="true"/>
        <env name="PROCESSING_URL" value="http://python-api:8000" force="true"/>
        <env name="QUARANTINE_BUCKET" value="kern-quarantine" force="true"/>
        <env name="SOURCES_STORAGE_DISK" value="s3" force="true"/>
        <env name="SOURCES_IDENTIFY_AS" value="browser" force="true"/>
        <env name="SOURCES_BROWSER_USER_AGENT" value="Mozilla/5.0 (Test) Chrome/128.0.0.0" force="true"/>
        <env name="SOURCES_CRAWLER_NAME" value="Kern-RO-SourceCrawler/1.0" force="true"/>
        <env name="SOURCES_CRAWLER_CONTACT" value="" force="true"/>
        <env name="OPERATIONS_CRON_INVESTMENTS_IMPORT_GOVERNMENT_BONDS" value="0 4 * * 0" force="true"/>
        <env name="OPERATIONS_CRON_INVESTMENTS_IMPORT_BVB" value="30 18 * * 1-5" force="true"/>
        <env name="OPERATIONS_CRON_LEGISLATION_WATCH" value="5 * * * *" force="true"/>
        <env name="LEGISLATION_WATCHES_LOCK_SECONDS" value="900" force="true"/>
        <env name="LEGISLATION_WATCHES_OVERLAP_DAYS" value="31" force="true"/>
        <env name="LEGISLATION_WATCHES_INTERVALS" value="24,168,720" force="true"/>
        <env name="LEGISLATION_WATCHES_MAX_NEW_ACTS" value="50" force="true"/>
        <env name="LEGISLATION_IMPORT_MAX_ACTS" value="50" force="true"/>
        <env name="LEGISLATION_WATCHES_MAX_PER_PERSON" value="20" force="true"/>
        <env name="LEGISLATION_WATCHES_QUEUE" value="legislation-watches" force="true"/>
        <env name="LEGISLATION_SEARCH_WEIGHT_MEANING" value="0.5" force="true"/>
        <env name="LEGISLATION_SEARCH_WEIGHT_WORDS" value="0.3" force="true"/>
        <env name="LEGISLATION_SEARCH_WEIGHT_LABEL" value="0.2" force="true"/>
        <env name="LEGISLATION_SEARCH_MIN_LABEL" value="0.3" force="true"/>
        <env name="LEGISLATION_SEARCH_MIN_MEANING" value="0.3" force="true"/>
        <env name="LEGISLATION_SEARCH_RESULTS" value="20" force="true"/>
        <env name="LEGISLATION_SEARCH_MAX_RESULTS" value="50" force="true"/>
        <env name="TAX_MINIMUM_WAGE_WATCH_SEARCH" value="salariului de bază minim brut" force="true"/>
        <env name="TAX_MINIMUM_WAGE_WATCH_ACT_TYPE" value="HOTARARE" force="true"/>
        <env name="TAX_MINIMUM_WAGE_WATCH_TITLE_PATTERN" value="/stabilirea salariului de baz[aă] minim brut pe [tţț]ar[aă] garantat [iî]n plat[aă]/iu" force="true"/>
        <env name="TAX_MINIMUM_WAGE_WATCH_FIRST_YEAR" value="2016" force="true"/>
        <env name="TAX_MINIMUM_WAGE_WATCH_HOURS" value="168" force="true"/>
        <env name="INVESTMENTS_ORDERS_WATCH_HOURS" value="168" force="true"/>
        <env name="INVESTMENTS_BVB_BASE_URL" value="https://www.bvb.ro" force="true"/>
        <env name="INVESTMENTS_BVB_SHARES_URL" value="https://www.bvb.ro/FinancialInstruments/Markets/Shares" force="true"/>
        <env name="INVESTMENTS_BVB_BONDS_URL" value="https://www.bvb.ro/FinancialInstruments/Markets/Bonds" force="true"/>
        <env name="INVESTMENTS_BVB_DIVIDENDS_URL" value="https://www.bvb.ro/FinancialInstruments/CorporateActions/InfoDividend" force="true"/>
        <env name="INVESTMENTS_BVB_INSTRUMENT_URL" value="https://www.bvb.ro/FinancialInstruments/Details/FinancialInstrumentsDetails.aspx?s={symbol}" force="true"/>
        <env name="INVESTMENTS_BVB_TIMEZONE" value="Europe/Bucharest" force="true"/>
        <env name="INVESTMENTS_ORDERS_ACT_TYPE" value="ORDIN" force="true"/>
        <env name="INVESTMENTS_FIDELIS_SEARCH" value="Programul FIDELIS" force="true"/>
