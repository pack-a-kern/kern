# ===========================================================================
# The variables of each installed package are documented by that package, in its own `.env.example`.
# `php artisan kern:env` prints this file followed by all of theirs, which is the whole environment:
#
#     php artisan kern:env > .env
#
# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="Kern"
APP_ENV=production
# Generate with: docker compose run --rm app php artisan key:generate --show
APP_KEY=
# A Laravel debug page renders the entire environment — every password and key below — to whoever
# provoked the error. Debug is opted into for local work, never left on.
APP_DEBUG=false
# Every address the application is actually reached at matters: this one is used for links in mail,
# for the passkey origin, and as the default list of origins allowed to open a WebSocket.
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Where the packages mount the JSON routes they ship. `api` unless something already owns that path;
# every package's endpoints move with it.
KERN_ROUTE_PREFIX=api

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
# The bundled container is created with DB_DATABASE / DB_USERNAME / DB_PASSWORD, so these are both
# what the application connects with and what it connects to. For a database you already run, set
# DB_HOST to its address and leave that container out.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=kern
DB_USERNAME=kern
# Generate with: openssl rand -hex 32
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Redis — cache, queue, sessions, broadcasting, rate limiting
# ---------------------------------------------------------------------------
# No database-backed cache, queue or session table: all four go through Redis.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
# Generate with: openssl rand -hex 32. The bundled container requires exactly this password.
REDIS_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis

# The Redis key prefix Horizon's own metrics live under.
HORIZON_PREFIX=kern_horizon:
# How long a queued job may run before the worker gives up on it. The AI lane is separate because a
# model call is minutes where an ordinary job is seconds; it must stay above every AI_* timeout.
# HORIZON_DEFAULT_QUEUE_TIMEOUT_SECONDS=
# HORIZON_AI_QUEUE_TIMEOUT_SECONDS=

# ---------------------------------------------------------------------------
# Reverb — the WebSocket broadcaster
# ---------------------------------------------------------------------------
BROADCAST_CONNECTION=reverb
# Generate each with: openssl rand -hex 16
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Where the application PUBLISHES an event — inside the network, so the container's name. The browser
# reaches Reverb through nginx instead, at whatever address served the page.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
# What the Reverb process itself binds. Not an address anything connects to.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# The page origins allowed to open a socket, comma-separated. Reverb compares the HOST only, so these
# are hostnames — `example.test`, `ip`, `localhost` — and a full URL is reduced to its
# host. `Str::is` patterns work: `*.example.test` covers subdomains, `*` allows everything and should
# stay out of production, because this check is what stops a page on another site from opening a
# socket against this one with a visitor's cookies.
#
# Unset it defaults to APP_URL's host, which is wrong the moment the application is served from
# anywhere else — and the failure is quiet: the socket connects, then delivers nothing (code 4009).
REVERB_ALLOWED_ORIGINS=localhost

# ---------------------------------------------------------------------------
# The browser's own copy — baked into the assets when they are BUILT
# ---------------------------------------------------------------------------
# Changing one of these takes effect after the frontend is rebuilt, not on a container restart.
# Must equal REVERB_APP_KEY above. It identifies the application to the WebSocket server, the way a
# Pusher app key does, and is public by design — a channel's own authorization is what protects a
# subject's events, not secrecy of this key.
VITE_REVERB_APP_KEY=
# Left empty the browser uses the host, port and scheme that served the page, which is the only thing
# that is right for every way the site is reached. Set them only for a Reverb on its own hostname.
VITE_REVERB_HOST=
VITE_REVERB_PORT=
VITE_REVERB_SCHEME=
# Which interface palette a person sees before they choose one. Must name an entry in
# resources/js/lib/palette.ts; anything else falls back to kernBlue rather than leaving the app
# unstyled.
VITE_DEFAULT_PALETTE=legacyV16V17

# ---------------------------------------------------------------------------
# Object storage — S3, or anything that speaks it
# ---------------------------------------------------------------------------
# Two buckets on one connection: documents (encrypted before they are written) and quarantine, where
# an upload waits for its virus scan. Separate buckets, not folders, so a mistake in one path cannot
# serve the other's contents.

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT=
AWS_BUCKET=kern-documents
QUARANTINE_BUCKET=kern-quarantine
# Keep this true for MinIO, and for AWS drop it and AWS_ENDPOINT both.
AWS_USE_PATH_STYLE_ENDPOINT=true
# MinIO ignores the region; the AWS SDK insists on having one.
AWS_DEFAULT_REGION=eu-central-1

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
# `log` writes mail to the log instead of sending it. The bundled mailpit accepts everything and shows
# it at http://localhost:8025 — set MAIL_MAILER=smtp to use it.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="Kern"

# ---------------------------------------------------------------------------
# The processing service (apps/processing)
# ---------------------------------------------------------------------------
# Where it answers, and the shared secret both sides require. The service returns 401 without it and
# the application refuses to call it with an empty one, so an unset token fails closed on both ends.
# Generate with: openssl rand -hex 32
PROCESSING_URL=http://python-api:8000
INTERNAL_SERVICE_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Not read by Laravel: the containers, and the ports they publish
# ---------------------------------------------------------------------------
# Everything from here down is read by compose.yaml alone — how much the containers may use, which
# host ports they publish, and the settings of the Python service, which has no Laravel config.

# Which host ports the stack publishes. Postgres, Redis is published only in development
# (compose.override.yaml) and are not reachable from outside the machine otherwise.
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443
POSTGRES_DEV_PORT=5432
REDIS_DEV_PORT=6379
MAILPIT_UI_PORT=8025
VITE_DEV_PORT=5173

# Memory for the queue container, shared by every worker in it. Reading a law holds one consolidation
# (~7.6 MB of HTML) as a DOM, and at 512M the kernel killed that worker mid-page.
QUEUE_MEMORY_LIMIT=2G
PYTHON_API_CPUS=2.00
PYTHON_API_MEMORY=1G

# A private AI endpoint — one on a VPN or a LAN — usually resolves only through the host's
# /etc/hosts, which containers never read: the provider answers from a terminal and is unreachable
# from the application, with nothing in the error to explain why. Setting both halves publishes the
# mapping inside the containers. Leave them unset for a provider with ordinary public DNS.
AI_ENDPOINT_HOST=
AI_ENDPOINT_IP=

# The embedding model, inside the processing service. EMBEDDING_MODEL_ID and EMBEDDING_DIMENSION are
# documented by kern/legislation, which reads the same two variables — one name per value, so the
# application and the service that loads the model cannot disagree.
EMBEDDING_REVISION=main
EMBEDDING_MAX_TOKENS=512
EMBEDDING_BATCH_SIZE=16
# A 118 MB int8 build; needs AVX512-VNNI. On a host without it use model_O4.onnx (235 MB).
EMBEDDING_ONNX_FILE=model_qint8_avx512_vnni.onnx
# E5 mean-pools and wants these prefixes. A symmetric model (bge-m3) uses "cls" and empty prefixes.
EMBEDDING_POOLING=mean
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_PASSAGE_PREFIX="passage: "
# Download the weights at boot rather than on the first request.
EMBEDDING_WARM_ON_STARTUP=false

# How much of a bank statement the reader will take. A current account's five years is comfortably
# under 20 000 rows; beyond these the file is something other than a statement, and is refused before
# anything parses it. The preamble is the lines above the table header that are returned with it —
# the bank, the account, the period.
STATEMENT_PARSE_MAX_ROWS=20000
STATEMENT_PARSE_MAX_FILE_SIZE_BYTES=10485760
STATEMENT_PARSE_MAX_PDF_PAGES=60
STATEMENT_PARSE_MAX_PREAMBLE_ROWS=20
