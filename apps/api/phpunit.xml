        <env name="INVESTMENTS_TEZAUR_TITLE_PATTERN" value="/în cadrul Programului Tezaur/iu" force="true"/>
        <env name="INVESTMENTS_SUBSCRIPTIONS_PAGE_URL" value="https://mfinante.gov.ro/ro/web/trezor/subscrieri-realizate-prin-tezaur-%C8%99i-fidelis" force="true"/>
        <env name="INVESTMENTS_SUBSCRIPTIONS_FIDELIS_FILE" value="/FIDELIS[\w-]*\.xlsx/i" force="true"/>
        <env name="INVESTMENTS_SUBSCRIPTIONS_TEZAUR_FILE" value="/TEZAUR[\w-]*\.xlsx/i" force="true"/>
        <env name="INVESTMENTS_WRITE_CHUNK" value="500" force="true"/>
        <env name="INVESTMENTS_QUEUE" value="default" force="true"/>
        <env name="INVESTMENTS_API_PAGE_SIZE" value="50" force="true"/>
        <env name="KERN_PAGE_SIZES" value="10,25,50,100" force="true"/>
        <env name="KERN_PAGE_SIZE_DEFAULT" value="25" force="true"/>
        <env name="SUBJECTS_DEFAULT_COUNTRY" value="RO" force="true"/>
        <env name="SUBJECTS_LIMIT_DEFAULT" value="1" force="true"/>
        <env name="SUBJECTS_LIMIT_VIEWER" value="1" force="true"/>
        <env name="SUBJECTS_LIMIT_ACCOUNTANT" value="50" force="true"/>
        <env name="SUBJECTS_LIMIT_ADMIN" value="100" force="true"/>
        <env name="SUBJECTS_LIMIT_SUPER_ADMIN" value="1000" force="true"/>
        <env name="SUBJECTS_MAX_ACTIVE" value="50" force="true"/>
        <env name="TAX_FIRST_FISCAL_YEAR" value="2018" force="true"/>
        <env name="INVESTMENTS_API_MAX_SPAN_DAYS" value="1830" force="true"/>
