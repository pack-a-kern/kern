# ===========================================================================
# kern/legislation — reading the law, and the rates a law refers to
# ===========================================================================
# Every value in force is written here rather than left to a default in the config file. The two with
# no value are the ones only this installation can answer.
#
# `php artisan kern:env` collects this file with the application's and every other package's.

# --- where a source document comes from, and where it is kept -----------------------------------
# The legislation portal's SOAP service, and how long one request to it may take — also on the settings
# screen, under Legislation portal. A consolidation of the Codul fiscal is ~7.6 MB of HTML, hence the
# patience.
LEGISLATIE_SOAP_URL=https://legislatie.just.ro/apiws/FreeWebService.svc/SOAP
LEGISLATIE_FETCH_TIMEOUT_SECONDS=300
# How the portal is searched — `soap` (its web service) or `browser` (its search page, through the
# browser worker) — and how a law's pages are read: `direct` or `browser`. Each is used alone: a failure
# is reported, never retried the other way. Both are also on the settings screen.
LEGISLATIE_SEARCH=soap
LEGISLATIE_PAGES=direct
# How long one search through the browser may keep reading pages of results, in all.
LEGISLATIE_SEARCH_DEADLINE_SECONDS=90
# What this installation's own requests to the portal call themselves. The portal refuses a client that
# does not look like a browser.
LEGISLATIE_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36"

# BNR's daily reference rates, and the TLS curves its server will negotiate. The curve list is not
# decoration: without it the handshake fails outright against that host.
BNR_DAILY_XML_URL=https://curs.bnr.ro/nbrfxrates.xml
BNR_TLS_CURVES=X25519:P-256:P-384

# Ceilings on one fetch. A source is the evidence behind every number this system produces, so a
# fetch that is too large, too slow or redirected too often fails rather than storing something
# partial. 10 MiB.
SOURCES_FETCH_MAX_BYTES=10485760
SOURCES_FETCH_MAX_REDIRECTS=5

# How the crawler names itself to ANAF, MF, BNR, ECB and GLEIF, and who those sources can write to
# about this installation's crawling — an address or an https URL of your own. Sent together in its
# User-Agent; empty contact, the crawler is named without one.
SOURCES_CRAWLER_NAME=Kern-RO-SourceCrawler/1.0
SOURCES_CRAWLER_CONTACT=
SOURCES_FETCH_TIMEOUT_SECONDS=15

# Which filesystem disk the fetched originals are kept on, and under which prefix. The disk is
# defined by the application (config/filesystems.php); no default, because a disk name is a fact
# about that application and not about this package.
SOURCES_STORAGE_DISK=s3
SOURCES_STORAGE_PREFIX=sources

# How a rate is stored and checked: the number of decimals a rate keeps — changing it changes every
# number computed from a rate — and how far a re-fetched rate may differ from the stored one before
# the pair is reported instead of accepted.
FX_DECIMAL_SCALE=6
FX_VERIFICATION_TOLERANCE=0.0001

# Which currencies the application's own forms offer. Not a filter on the import: every currency the
# central bank publishes is stored either way, because a rate nobody asked for costs nothing to keep
# and a year nobody imported cannot be reconstructed later. The default is editable on the settings
# screen, and the base currency is added back whether or not it is named here.
FX_CURRENCIES=RON,EUR,USD,GBP,CHF

# --- reading a law ------------------------------------------------------------------------------
# The queue one consolidation is read on, and how long that may take: download, parse, index. The
# Horizon supervisor and the queue's retry_after both read the timeout, so raising it raises all three.
LEGISLATION_QUEUE=legislation
LEGISLATION_QUEUE_TIMEOUT_SECONDS=1800
# The pauses before a consolidation the portal did not serve is tried again.
LEGISLATION_SYNC_RETRY_SECONDS=30,120,300
# How many chunks are embedded at once, and the earliest year the ingest task offers.
LEGISLATION_EMBEDDING_BATCH=256
LEGISLATION_MIN_YEAR=2015
# Searches per account per window. Each one embeds the query on this server's CPU.
LEGISLATION_SEARCH_RATE_LIMIT_MAX_ATTEMPTS=30
LEGISLATION_SEARCH_RATE_LIMIT_DECAY_SECONDS=60

# --- reading a law for its fiscal values --------------------------------------------------------
# Which model reads. No default: a model name is a fact about the endpoint you point at, and a wrong
# one should say so rather than be assumed.
LEGISLATION_AI_MODEL=qwen3.8:latest
# A second reader catches what verification cannot — asked for the cap on independent activities, one
# model quoted, correctly and verifiably, the band for a different kind of income. Named as nothing,
# no second call is made and the person approving is the check.
LEGISLATION_AI_SECOND_MODEL=
# Room for the reply, deliberately large: a thinking model spends most of its budget before it writes
# anything, and at 1200 tokens one returned an empty string with finish_reason: length.
LEGISLATION_AI_MAX_TOKENS=32000
# One reading. Note that any proxy in front of the model has its own timeout, and the smaller of the
# two is what you actually get.
LEGISLATION_AI_TIMEOUT_SECONDS=240
# How much of the chapter travels with the question: the articles nearest it, whole, and up to this
# many paragraphs between them. From which year the law is read at all.
LEGISLATION_AI_ARTICLES=3
LEGISLATION_AI_PARAGRAPHS=60
LEGISLATION_AI_FROM_YEAR=2018

# --- semantic search over the law ---------------------------------------------------------------
# The model runs inside the processing service, not through an external API: the corpus is public
# legislation, but a question asked of it can carry personal context, and self-hosting means neither
# leaves the machine.
#
# Off by default. An installation whose processing image predates the embedding dependencies must keep
# failing loudly rather than start throwing connection errors inside a backfill.
RETRIEVAL_EMBEDDING_ENABLED=false
# Generous: the very first call downloads the weights and builds an ONNX session. Later calls are
# milliseconds.
RETRIEVAL_EMBEDDING_TIMEOUT_SECONDS=900
# How many chunks this application sends per request — not the model's own batch size, which is
# EMBEDDING_BATCH_SIZE and belongs to the processing service.
RETRIEVAL_EMBEDDING_BATCH_SIZE=32

# The model itself, and the width of the vectors it emits. One name each, read by BOTH this
# application and the processing service that loads the model — a second name for the same value is
# how the two come to disagree, and they must not: the dimension has to equal the `vector(N)` column
# the chunks are stored in, or searches land in a space nothing can find.
EMBEDDING_MODEL_ID=intfloat/multilingual-e5-small
EMBEDDING_DIMENSION=384

# --- what the reader is told --------------------------------------------------------------------
# Left unset: these are paragraphs, and they live in config/ai/legislation.php where a sentence is
# reviewable in a diff rather than a single long line in an env file. Set one to override it.
# LEGISLATION_PROMPT_SYSTEM=
# LEGISLATION_PROMPT_INSTRUCTION=
# LEGISLATION_PROMPT_INSTRUCTION_TOGETHER=
