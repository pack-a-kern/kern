# ===========================================================================
# kern/tax-romania — the Romanian product: subjects, SPV, statements, schedule
# ===========================================================================
# Every variable here is read by the config file named above its group, and already has a default
# there — which is why each is listed commented out, and why the default is not repeated here: the
# config file is the one place it is written down. Uncomment one only to change it.
#
# `php artisan kern:env` collects this file together with the application's and every other
# installed package's. tests/Feature/Config/ConfigKeysTest.php fails when this package's config
# reads a variable this file does not name.

# --- config/subjects.php ---------------------------------------------------
# The country a new tax subject is assumed to be in, and how many subjects each role may hold. The
# limits are what stops one account from being used as an unbilled accounting practice.
# SUBJECTS_DEFAULT_COUNTRY=
# SUBJECTS_LIMIT_DEFAULT=
# SUBJECTS_LIMIT_VIEWER=
# SUBJECTS_LIMIT_ACCOUNTANT=
# SUBJECTS_LIMIT_ADMIN=
# SUBJECTS_LIMIT_SUPER_ADMIN=

# --- config/fiscal_parameters.php ------------------------------------------
# The law the fiscal values are read from, the currency they are expressed in, and how long one
# reading holds its lock so two runs cannot write the same year's values at once.
# FISCAL_PARAMETERS_LAW=
# FISCAL_PARAMETERS_CURRENCY=
# FISCAL_PARAMETERS_LOCK_SECONDS=

# --- config/spv.php --------------------------------------------------------
# ANAF's web service, and the client certificate that identifies this installation to it. The
# certificate is the credential — a path to a file the container can read, and its password.
# ANAF_SPV_CLIENT_CERTIFICATE_PATH=
# ANAF_SPV_CLIENT_CERTIFICATE_PASSWORD=
# ANAF_SPV_WEBSERVICE_BASE_URL=
# ANAF_SPV_WEBSERVICE_TIMEOUT_SECONDS=
# How far back a message list is asked for. The service answers a window, not everything.
# ANAF_SPV_WEBSERVICE_MESSAGES_WINDOW_DAYS=
# The browser worker that signs in to SPV on a person's behalf, for what the web service does not
# expose: where it answers, the token it requires, and how long one session may take.
# SPV_BROWSER_BASE_URL=
# SPV_BROWSER_AUTH_TOKEN=
# SPV_BROWSER_TIMEOUT_SECONDS=
# How long a sign-in challenge waits for the person to approve it on their device.
# SPV_CHALLENGE_TTL_SECONDS=

# --- config/statement_import.php -------------------------------------------
# What a bank statement may be, and how it is taken in. A current account's five years is comfortably
# under the row ceiling; beyond it the file is something other than a statement.
# STATEMENT_IMPORT_MAX_FILE_BYTES=
# The size of one database write while committing, and how many rows the review screen shows before
# anything is committed.
# STATEMENT_IMPORT_COMMIT_CHUNK=
# STATEMENT_IMPORT_PREVIEW_ROWS=
# STATEMENT_IMPORT_PREVIEW_TRANSACTIONS=
# STATEMENT_IMPORT_MAX_TAGS_PER_ROW=
# An uploaded statement is scanned before it is read. These bound the wait for that verdict — how
# many times the scan is checked, and how long between checks.
# STATEMENT_IMPORT_SCAN_WAIT_CHECKS=
# STATEMENT_IMPORT_SCAN_WAIT_SECONDS=
# Parsing runs in the processing service: how long one parse may take, and how long before a parse
# that did not answer is tried again.
# STATEMENT_PARSE_TIMEOUT_SECONDS=
# STATEMENT_PARSE_RETRY_SECONDS=
# Below this many rows the file is parsed in the request instead of on a queue, because waiting for a
# worker to pick up twenty rows is slower than doing it.
# STATEMENT_IMPORT_PARSE_THRESHOLD=

# --- config/ai/statements.php ----------------------------------------------
# Statement import's two model calls: mapping a statement's columns, and suggesting a category and
# tags for its counterparties. Each has its own model, token room and timeout, because they are
# different jobs — one reads a header, the other reads hundreds of rows.
# STATEMENT_IMPORT_AI_MODEL=
# STATEMENT_IMPORT_AI_MAX_TOKENS=
# STATEMENT_IMPORT_AI_TIMEOUT_SECONDS=
# Whether the counterparties are put to a model at all. Off, the rows are still staged, still filled
# in from earlier decisions, and still answerable by hand — only the calls do not happen, and the
# review opens at once.
# STATEMENT_IMPORT_CLASSIFICATION_ENABLED=
# STATEMENT_IMPORT_CLASSIFICATION_MODEL=
# STATEMENT_IMPORT_CLASSIFICATION_MAX_TOKENS=
# STATEMENT_IMPORT_CLASSIFICATION_BATCH=
# A PDF statement converted to a table by the provider before it is read (AI_SUPPORTS_CONVERSION):
# the format asked for, the name the file travels under, and how long the conversion may take.
# STATEMENT_IMPORT_CONVERSION_FORMAT=
# STATEMENT_IMPORT_CONVERSION_FILENAME=
# STATEMENT_IMPORT_CONVERSION_TIMEOUT_SECONDS=
# The wording of both calls, here so it can be tuned without a deployment.
# STATEMENT_PROMPT_MAPPING_SYSTEM=
# STATEMENT_PROMPT_MAPPING_INSTRUCTION=
# STATEMENT_PROMPT_CLASSIFICATION_SYSTEM=
# STATEMENT_PROMPT_CLASSIFICATION_INSTRUCTION=

# --- config/wallet.php -----------------------------------------------------
# Applied to every new deposit and shown read-only on the form. Not a choice, because the convention
# comes from the bank's contract, and 360 instead of 365 as the denominator moves the interest by
# about 1.4% with nothing about the result looking wrong. ACTUAL/365 is usual for RON term deposits;
# a deposit whose contract says otherwise is still accepted by the API, which takes any convention.
# WALLET_DEPOSIT_DEFAULT_DAY_COUNT=
# The terms the "add deposit" form offers, in months. A deposit is bought as a length, and the
# maturity date is derived from it — gross interest is `principal x rate x days / denominator` and
# those days are counted from the opening date to the derived one, so this list is what stands
# between a person and a hand-typed date that is a day out.
# WALLET_DEPOSIT_TERMS_MONTHS=

# --- config/banks.php ------------------------------------------------------
# The list of banks, and the backfill of those that closed before the first import: the first month
# read, and how many days into each month to look for its first published list.
# BANKS_BACKFILL_FROM=
# BANKS_BACKFILL_DAYS_TO_TRY=
# BANKS_CATEGORIES=
# BANKS_COUNTRIES=

# --- config/operations.php -------------------------------------------------
# The scheduler's liveness marker, written every minute and read in two places, because two
# audiences fail independently.
#
# The FILE is read by the scheduler container's own healthcheck. Local on purpose: a healthcheck that
# went red because Redis was down would restart a healthy scheduler. The script reading it runs
# before the framework boots, so it reads these two variables directly rather than the config.
# OPERATIONS_HEARTBEAT_PATH=
# Three missed minutes. One missed tick is a slow container, not an outage.
# OPERATIONS_HEARTBEAT_MAX_AGE_SECONDS=
# The CACHE KEY is read by the operations screen, which is rendered by the application container —
# and that container has its own /tmp, so it cannot see the file above at all. The TTL is long enough
# that a stall's duration is still reportable: an expired key can only say "stalled".
# OPERATIONS_HEARTBEAT_CACHE_KEY=
# OPERATIONS_HEARTBEAT_CACHE_TTL_SECONDS=
# *When* each scheduled task runs. Timing lives here rather than in the database on purpose: a cron
# expression typed into a web form is how a job silently stops running forever. *Whether* a task runs
# is the one runtime switch, held in `scheduled_tasks.enabled` and read on every tick.
# OPERATIONS_SCHEDULE_TIMEZONE=
# Weekdays at 14:00 Bucharest — BNR publishes the daily reference rates around midday.
# OPERATIONS_CRON_FX_IMPORT_DAILY=
# OPERATIONS_CRON_BANKS_IMPORT=
# OPERATIONS_CRON_LEGISLATION_SYNC=
# OPERATIONS_CRON_DEPOSIT_POST_INTEREST=
# A manual run is dispatched to a queue, never executed inside the HTTP request. The lock is held
# while a run is in flight so a double-click cannot start two imports over the same day; it is longer
# than the slowest task and self-expiring, so a crashed worker cannot wedge a task permanently.
# OPERATIONS_RUN_QUEUE=
# OPERATIONS_RUN_LOCK_SECONDS=
# OPERATIONS_RUN_MAX_OUTPUT_BYTES=
# The freshness thresholds behind the "is this data current?" panel. Four days covers a Friday import
# followed by a Monday public holiday.
# OPERATIONS_FX_MAX_AGE_DAYS=
# OPERATIONS_DOCUMENT_STUCK_AFTER_MINUTES=
# BNR's yearly archives start in 2005; the upper bound is the current year, resolved at runtime.
# OPERATIONS_FX_BACKFILL_MIN_YEAR=
# Which document types the legislation panel counts, and how long each component's health check may
# take before it is reported as not answering.
# OPERATIONS_LEGISLATION_DOCUMENT_TYPES=
# OPERATIONS_HEALTH_TIMEOUT_SECONDS=
