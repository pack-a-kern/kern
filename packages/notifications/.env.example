# ===========================================================================
# kern/notifications — the bell, and notices on people's devices (Web Push)
# ===========================================================================
# Every value in force is written here, not left to a default in the config file.
#
# `php artisan kern:env` collects this file with the application's and every other package's.

# --- endpoints ----------------------------------------------------------------------------------
# Where the bell, the person's choices and their devices are served. Each acts for the signed-in
# person only.
NOTIFICATIONS_ROUTE_PREFIX=api/v1/notifications
# How many unread notices the bell lists at most.
NOTIFICATIONS_BELL_LIMIT=20

# --- devices ------------------------------------------------------------------------------------
# The server's key pair towards the browsers' push services. The installer writes one; on an existing
# installation `php artisan notifications:keys` prints one. Empty: the preferences endpoint says
# device notifications are not set up, and nothing is sent. A new pair stops every device subscribed
# under the old one until it turns notifications on again.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
# Who the push services may contact about this server's sends: a mailto: or an https: address. Empty
# is APP_URL.
WEB_PUSH_SUBJECT=
# How long a push service holds a notice for a device that is off, in seconds.
WEB_PUSH_TTL_SECONDS=86400
# Devices one person may have notices on at once.
WEB_PUSH_MAX_DEVICES=10
