includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/pestphp/pest-plugin-phpstan/extension.neon

parameters:
    level: 9
    # Larastan infers a model's column types by reading migrations, and it looks in the
    # application's `database/migrations` alone. Half the schema now lives in packages, and without
    # these a packaged model's every column reads as `mixed` — `(string) $user->getKey()` becomes a
    # cast from mixed, and `$user->created_at` an undefined property. The alternative is hand-written
    # `@property` blocks on every packaged model, which is a second source of truth for the schema.
    databaseMigrationsPath:
        - database/migrations
        - ../../packages/audit/database/migrations
        - ../../packages/documents/database/migrations
        - ../../packages/legislation/database/migrations
        - ../../packages/tax-romania/database/migrations
        - ../../packages/platform/database/migrations
    paths:
        # `../../packages/*` is `<repository>/packages` from the host and `/var/packages` from
        # inside a container whose root is `/var/www/html` — the same files Composer symlinks into
        # `vendor/kern/*`, analysed as source rather than skipped as a dependency. A package with no
        # static analysis is a package that breaks the application it was extracted from.
        - ../../packages/audit/src
        - ../../packages/documents/src
        - ../../packages/legislation/src
        - ../../packages/tax-romania/src
        - ../../packages/platform/src
        - app
        - bootstrap/app.php
        - bootstrap/providers.php
        - config
        - database
        - routes
        - tests
    excludePaths:
        - resources/js
        # tests/Fixtures/TaxEngine/Purity/ImpureEnvironmentRule.php is a DELIBERATELY IMPURE
        # fixture (docs/handoff/020-tax-engine.md) — its one line exists only so
        # Tests\Support\TaxEngineRulePurity\RulePuritySourceScanner has a real env() read to
        # detect when tests/Unit/Domain/TaxEngine/RulePuritySourceScannerTest.php and
        # tests/Feature/Domain/TaxEngine/RulePurityArchitectureTest.php scan its raw source text.
        # The class is never instantiated or executed by any test — only lexically scanned as
        # text — so Larastan's real "no env() outside config" rule firing on it is not a defect
        # to silence with a baseline entry; the violation is the fixture's entire purpose. Same
        # treatment a fixture with deliberately malformed content gets from any other linter.
        - tests/Fixtures/TaxEngine/Purity/ImpureEnvironmentRule.php
