APP_NAME="TaxOS România"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=ro
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ro_RO

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Blueprint §1.1: PostgreSQL is the primary datastore.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=taxos
DB_USERNAME=taxos
DB_PASSWORD=

# Blueprint §1.1: Redis backs cache, queue coordination, rate limiting,
# broadcasting and sessions — no database-backed cache/queue/session tables.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
# CACHE_PREFIX=

QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Blueprint §3.2: Reverb is the only WebSocket broadcaster.
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

HORIZON_PREFIX=taxos_horizon:

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Blueprint §1.1: S3-compatible storage; local/dev = MinIO.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=taxos-documents
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

# --- Blind index (MANDATORY) ---------------------------------------------------------------
# The global, versioned HMAC key used for exact-match lookups on encrypted columns
# (login by email, duplicate-identifier detection). BLUEPRINT.md §4.4.
# Format: a JSON object mapping version => base64-encoded 32-byte key, e.g. {"1":"<base64>"}.
# Generate: php -r 'echo json_encode(["1" => base64_encode(random_bytes(32))]), PHP_EOL;'
# Without it the application throws on ANY blind-index operation — registration and login included.
CRYPTO_BLIND_INDEX_KEYS=
CRYPTO_BLIND_INDEX_CURRENT_VERSION=1


# Fallback AI provider configuration, consulted only for a field that has never been saved via
# PUT /api/v1/settings/ai (App\Domain\Settings\Services\ResolveAiProviderCredentials). Named to
# match apps/processing's own AI_* variables for operator familiarity — these are two independent
# environments, not a shared value.
AI_ENABLED=false
AI_PROVIDER=
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# ===========================================================================
# TaxOS — application settings
# ===========================================================================
# Every variable below is read by the config file named above its group, and already has a
# default there — which is why each is listed commented out, and why its value is not repeated
# here: the config file is the one place a default is written down. Uncomment one only to change it.
#
# Under docker compose this file, as apps/api/.env, is read by Laravel for anything compose does
# not set itself. A variable marked `(compose)` is set by compose.yaml from the root .env, and a
# value for it here would be ignored — change it in the root .env instead.
#
# tests/Feature/Config/ConfigKeysTest.php fails when config reads a variable this file does not name.

# --- config/ai/documents.php ---
# The largest document sent for a model to look at. Below the 15 MB an upload may be: base64 adds a
# third on top, and a gateway's own body limit is usually smaller than either. A document over this
# is not truncated — half a receipt is not a smaller receipt — it is reported as a failed extraction
# and typed in by hand.
# AI_EXTRACTION_MAX_IMAGE_BYTES=
# A ceiling on the *reply*, not a target: a model answering properly emits a hundred tokens of JSON
# and stops. Sized for a reasoning model, which spends the same budget thinking first — at 1024,
# `qwen3-vl:8b-thinking` used the entire allowance on its chain of thought and returned an empty
# answer, which is indistinguishable from a model that could not read the document.
# AI_EXTRACTION_MAX_TOKENS=
# Bounds one document extraction, which is a different order of work — loading a vision model, then
# an image, then generating. Measured 32-56s against a self-hosted 8B vision model. Runs on a queue
# worker, so a long wait costs nobody a loading spinner. Reusing the ping's 10s here would abandon
# every real extraction and misreport the provider as unreachable.
# AI_EXTRACTION_TIMEOUT_SECONDS=
# AI_PROMPT_INSTRUCTION=
# AI_PROMPT_ONLY_RELEVANT_FIELDS=
# AI_PROMPT_SYSTEM=

# --- config/ai/embeddings.php ---
# RETRIEVAL_EMBEDDING_BATCH_SIZE=   (compose)
# RETRIEVAL_EMBEDDING_DIMENSION=   (compose)
# RETRIEVAL_EMBEDDING_ENABLED=   (compose)
# RETRIEVAL_EMBEDDING_MODEL=   (compose)
# RETRIEVAL_EMBEDDING_TIMEOUT_SECONDS=   (compose)

# --- config/ai/providers.php ---
# Which provider, URL, model and key are *runtime settings*, edited in Administrare -> Setări
# sistem and stored in the database — the AI_* values above are only their starting point. What
# follows is the shape of the requests: budgets and ceilings that protect the system rather than
# describe the provider.
# Anthropic pins its API version in a header; every other dialect ignores this.
# AI_ANTHROPIC_VERSION=
# Bounds the settings screen's connection test: one token, answered in milliseconds. A provider
# slower than this is not usable interactively, which is exactly what the test decides.
# AI_HTTP_TIMEOUT_SECONDS=
# AI_JOB_TIMEOUT_MARGIN_SECONDS=
# AI_QUEUE=
# AI_SUPPORTS_CONVERSION=
# AI_SUPPORTS_ENHANCEMENT=

# --- config/ai/legislation.php ---
# Reading the law for the fiscal values: which model reads, which reads after it to catch a
# misreading, how many paragraphs of a chapter travel with a question, and from which year the law
# is read. The prompts are here so wording can be tuned without a deployment.
# LEGISLATION_AI_FROM_YEAR=
# LEGISLATION_AI_ARTICLES=
# LEGISLATION_AI_MAX_TOKENS=
# LEGISLATION_AI_MODEL=
# LEGISLATION_AI_PARAGRAPHS=
# LEGISLATION_AI_SECOND_MODEL=
# LEGISLATION_AI_TIMEOUT_SECONDS=
# LEGISLATION_PROMPT_INSTRUCTION=
# LEGISLATION_PROMPT_INSTRUCTION_TOGETHER=
# LEGISLATION_PROMPT_SYSTEM=

# --- config/ai/statements.php ---
# STATEMENT_IMPORT_AI_MAX_TOKENS=
# Statement import AI: model, token room and batch size for each of the two calls, and the queue and
# timeout the calls run under. HORIZON_AI_QUEUE_TIMEOUT_SECONDS must stay above the job timeouts.
# STATEMENT_IMPORT_AI_MODEL=
# STATEMENT_IMPORT_AI_TIMEOUT_SECONDS=
# STATEMENT_IMPORT_CLASSIFICATION_BATCH=
# Whether a statement's counterparties are put to a model at all. Off, the rows are still staged,
# still filled in from earlier decisions, and still answerable by hand.
# STATEMENT_IMPORT_CLASSIFICATION_ENABLED=true
# A PDF statement converted to CSV by the provider before it is read (AI_SUPPORTS_CONVERSION):
# the format asked for, the name the file travels under, and how long the conversion may take.
# STATEMENT_IMPORT_CONVERSION_FILENAME=
# STATEMENT_IMPORT_CONVERSION_FORMAT=
# STATEMENT_IMPORT_CONVERSION_TIMEOUT_SECONDS=
# STATEMENT_IMPORT_CLASSIFICATION_MAX_TOKENS=
# STATEMENT_IMPORT_CLASSIFICATION_MODEL=
# STATEMENT_PROMPT_CLASSIFICATION_INSTRUCTION=
# STATEMENT_PROMPT_CLASSIFICATION_SYSTEM=
# STATEMENT_PROMPT_MAPPING_INSTRUCTION=
# STATEMENT_PROMPT_MAPPING_SYSTEM=

