# ===========================================================================
# kern/documents — uploads, virus scanning, text extraction, AI reading
# ===========================================================================
# Every value in force is written here, not left to a default in the config file: a deployment
# decides these, and a number visible in one file beats a number you have to go and look up.
#
# `php artisan kern:env` collects this file with the application's and every other package's.
# tests/Feature/Config/ConfigKeysTest.php fails when this package reads a variable not named here.

# --- object storage -----------------------------------------------------------------------------
# Which disk documents are written to, encrypted. The disk itself is defined by the application
# (config/filesystems.php) — point THAT at your storage; this only chooses between its disks.
OBJECTSTORE_DISK=s3
# Bytes per chunk when streaming an object in or out. 4 MiB.
OBJECTSTORE_CHUNK_SIZE=4194304

# The disk unscanned uploads land on — a physically separate bucket, so a file nothing has looked at
# yet is unreachable from where clean documents are served.
DOCUMENTS_QUARANTINE_DISK=quarantine

# --- virus scanning -----------------------------------------------------------------------------
# Where clamd answers. Scanning cannot be turned off: an upload that cannot be scanned is refused.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
# Connect, then per-file. A scan is INSTREAM, so the whole file crosses this socket.
CLAMAV_CONNECT_TIMEOUT_SECONDS=5
CLAMAV_STREAM_TIMEOUT_SECONDS=30
CLAMAV_CHUNK_SIZE=65536

# --- what an upload may be ----------------------------------------------------------------------
# Each is a refusal with a reason, never a truncation: half a receipt is not a smaller receipt.
# 25 MiB.
DOCUMENTS_MAX_PDF_BYTES=26214400
DOCUMENTS_MAX_PAGES=10
# 15 MiB.
DOCUMENTS_MAX_IMAGE_BYTES=15728640
# Decompressed pixels, which is what actually costs memory: a small file can describe a huge image,
# and that is the shape of a decompression bomb.
DOCUMENTS_MAX_IMAGE_PIXELS=40000000
# The text one document may yield (10 MiB), and how long the extraction service may take for it.
DOCUMENTS_MAX_TEXT_BYTES=10485760
DOCUMENTS_TEXT_EXTRACTION_TIMEOUT_SECONDS=30

# Uploads per subject per window. Sized for someone emptying a folder of receipts, not a script.
DOCUMENTS_UPLOAD_RATE_LIMIT_MAX_ATTEMPTS=30
DOCUMENTS_UPLOAD_RATE_LIMIT_DECAY_SECONDS=60

# --- reading a document with a model ------------------------------------------------------------
# Which provider and model — Administrare -> Setări sistem, stored in the database. Only the limits
# of one reading are here.
#
# 8 MiB, under the 15 MiB an upload may be: base64 adds a third, and a gateway's body limit is
# usually smaller than either.
AI_EXTRACTION_MAX_IMAGE_BYTES=8388608
# Room for the reply. A model answering properly emits a few hundred tokens of JSON; a *thinking*
# model spends most of this budget before it writes anything, and at 1024 one returned nothing at all.
AI_EXTRACTION_MAX_TOKENS=4096
# One extraction: loading a vision model, then an image, then generating. Measured 32-56s on a
# self-hosted 8B. Runs on a queue worker, so a long wait costs nobody a spinner. Note that any proxy
# in front of the model has its own timeout, and the smaller of the two is what you actually get.
AI_EXTRACTION_TIMEOUT_SECONDS=120

# What the model is told. Here rather than in code so wording can be tuned without deploying — the
# field list is not here, it comes from `ExtractionSchema` so the prompt and the validator cannot
# disagree. Left unset: the sentences live in config/ai/documents.php, where a paragraph is
# reviewable in a diff rather than a 400-character line in an env file.
# AI_PROMPT_SYSTEM=
# AI_PROMPT_INSTRUCTION=
# AI_PROMPT_ONLY_RELEVANT_FIELDS=
