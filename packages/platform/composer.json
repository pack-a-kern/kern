{
    "name": "kern/platform",
    "description": "The security spine an application is built on: envelope encryption under per-tenant keys, blind indexes for exact lookup of encrypted values, an encrypted object store, tenant scoping, and a log processor that redacts what must never reach a log file.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-intl": "*",
        "ext-sodium": "*",
        "illuminate/auth": "^13.0",
        "illuminate/cache": "^13.0",
        "illuminate/config": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/filesystem": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/log": "^13.0",
        "illuminate/notifications": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "kern/audit": "@dev",
        "monolog/monolog": "^3.0",
        "spatie/laravel-permission": "^8.3",
        "spomky-labs/otphp": "^11.5",
        "web-auth/webauthn-lib": "^5.3"
    },
    "autoload": {
        "psr-4": {
            "Kern\\Platform\\": "src/",
            "Kern\\Platform\\Database\\Factories\\": "database/factories/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kern\\Platform\\PlatformServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "require-dev": {
        "fakerphp/faker": "^1.23"
    }
}
