<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="kern/investments">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <php>
        <!-- Read by config/sources.php as the package adds BVB to the registry. -->
        <env name="INVESTMENTS_BVB_BASE_URL" value="https://www.bvb.ro" force="true"/>
    </php>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
