{
    "name": "kern/audit",
    "description": "An append-only, hash-chained audit log: every entry carries the hash of the one before it, so a removed or edited row is visible as a break in the chain.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "ramsey/uuid": "^4.7"
    },
    "autoload": {
        "psr-4": {
            "Kern\\Audit\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kern\\Audit\\AuditServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
