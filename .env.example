# TaxOS România — docker compose environment.
#
# Copy to `.env` (already gitignored) and fill in real values for local
# development. Every variable here is consumed by compose.yaml/
# compose.override.yaml — see the `x-php-image` anchor and each service's
# `environment:` block for exactly where.
#
# This file itself must never contain a real secret — BLUEPRINT.md §4.10.
# Values below are placeholders or safe local-dev defaults only.

# ---------------------------------------------------------------------------
# Laravel application
# ---------------------------------------------------------------------------
APP_NAME="TaxOS România"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
# Generate with: docker compose run --rm app php artisan key:generate --show
APP_KEY=

# Whether strangers may create accounts. Only the starting value: an owner
# changes it from Administration -> Settings, and that choice wins from then on.
# An instance with no users accepts the first registration either way, so a
# fresh deployment cannot lock itself out.
REGISTRATION_ENABLED=true

# ---------------------------------------------------------------------------
# Postgres (primary datastore — BLUEPRINT.md §1.1)
# ---------------------------------------------------------------------------
POSTGRES_DB=taxos
POSTGRES_USER=taxos
POSTGRES_PASSWORD=
# Host-side port for `make db-shell` / a local psql client. Only reachable
# because compose.override.yaml (dev only) re-attaches postgres to a
# non-internal network purely to publish this — see that file's header.
POSTGRES_DEV_PORT=5432

# ---------------------------------------------------------------------------
# Redis (cache / queue / broadcasting / rate limiting — BLUEPRINT.md §1.1)
# ---------------------------------------------------------------------------
REDIS_PASSWORD=
REDIS_DEV_PORT=6379

# ---------------------------------------------------------------------------
# Reverb (WebSocket broadcaster — BLUEPRINT.md §3.2)
# ---------------------------------------------------------------------------
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Page origins allowed to open a websocket, comma-separated. Reverb refuses anything else with
# `pusher:error` code 4009 — the socket connects and then delivers nothing, which reads as a broken
# feature rather than a configuration problem.
#
# Reverb compares the HOST only, so these are hostnames: `example.test`, `your.server.ip`,
# `localhost`. A full URL is accepted too and reduced to its host (config/reverb.php), because
# either is a reasonable thing to write. `Str::is` patterns work — `*.example.test` covers
# subdomains, `*` allows everything and should stay out of production: this check is what stops a
# page on another site from opening a socket against this one with a visitor's cookies.
#
# List every address the app is actually reached at. The default is APP_URL's host, which is wrong
# the moment the app is served from anywhere else.
REVERB_ALLOWED_ORIGINS=localhost

# ---------------------------------------------------------------------------
# MinIO (S3-compatible object storage — BLUEPRINT.md §1.1, local/dev only;
# production points AWS_ENDPOINT at a real S3-compatible provider instead)
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_DEV_API_PORT=9000
MINIO_DEV_CONSOLE_PORT=9001

# ---------------------------------------------------------------------------
# OpenBao (KMS transit engine — BLUEPRINT.md §4.2)
#
# DEV MODE ONLY. `OPENBAO_DEV_ROOT_TOKEN` becomes the root token of an
# in-memory, unsealed-by-default dev server (compose.yaml's `openbao`
# service runs `bao server -dev`) — it has no relationship to a production
# KMS/Vault/OpenBao deployment, which must use a real storage backend,
# auto-unseal, and a properly scoped policy, never a root token baked into
# an env file. Do not reuse this token or this dev-mode flow anywhere but a
# developer's own machine.
# ---------------------------------------------------------------------------
OPENBAO_DEV_ROOT_TOKEN=

# ---------------------------------------------------------------------------
# Internal service auth (Laravel <-> python-api — BLUEPRINT.md §4.10,
# docs/handoff/024-extraction-endpoint.md). A single shared secret both
# services receive identically: python-api's processing.internal_auth fails
# closed (401) if it is unset; Laravel's HttpTextExtractionGateway sends it
# as `Authorization: Bearer <token>` and also fails closed if it is empty.
# Generate with: openssl rand -hex 32
# ---------------------------------------------------------------------------
INTERNAL_SERVICE_AUTH_TOKEN=

# --- Statement import (docs/handoff/045-statement-import.md) ---
# How much of a bank statement the reader will take. A current account's five years is comfortably
# under 20 000 rows; beyond these the file is something other than a statement, and is refused
# before anything parses it.
STATEMENT_PARSE_MAX_ROWS=20000
STATEMENT_PARSE_MAX_FILE_SIZE_BYTES=10485760
STATEMENT_PARSE_MAX_PDF_PAGES=60
# Statement import AI: model, token room and batch size for each of the two calls, and the queue and
# timeout the calls run under. HORIZON_AI_QUEUE_TIMEOUT_SECONDS must stay above the job timeouts.
STATEMENT_IMPORT_AI_MODEL=gpt-oss:20b
STATEMENT_IMPORT_AI_MAX_TOKENS=12000
STATEMENT_IMPORT_CLASSIFICATION_MODEL=gpt-oss:20b
STATEMENT_IMPORT_CLASSIFICATION_MAX_TOKENS=32000
STATEMENT_IMPORT_CLASSIFICATION_BATCH=100
STATEMENT_IMPORT_AI_TIMEOUT_SECONDS=600
STATEMENT_IMPORT_AI_QUEUE=documents-ai
HORIZON_AI_QUEUE_TIMEOUT_SECONDS=900

# ---------------------------------------------------------------------------
# Mail (dev only — BLUEPRINT.md §3.1 mailpit)
# ---------------------------------------------------------------------------
MAILPIT_UI_PORT=8025

# ---------------------------------------------------------------------------
# Edge / misc host port mappings
# ---------------------------------------------------------------------------
EDGE_HTTP_PORT=80
VITE_DEV_PORT=5173

# Which interface palette a person sees before they choose one. Must name an entry in
# apps/api/resources/js/lib/palette.ts; anything else falls back to taxosBlue rather than
# leaving the app unstyled.
VITE_DEFAULT_PALETTE=legacyV16V17

# --- Blind index (MANDATORY) ---------------------------------------------------------------
# The global, versioned HMAC key used for exact-match lookups on encrypted columns
# (login by email, duplicate-identifier detection). BLUEPRINT.md §4.4.
# Format: a JSON object mapping version => base64-encoded 32-byte key, e.g. {"1":"<base64>"}.
# Generate: php -r 'echo json_encode(["1" => base64_encode(random_bytes(32))]), PHP_EOL;'
# Without it the application throws on ANY blind-index operation — registration and login included.
CRYPTO_BLIND_INDEX_KEYS=
CRYPTO_BLIND_INDEX_CURRENT_VERSION=1

# ---------------------------------------------------------------------------
# Background operations (/admin/operatiuni) — docs/handoff/044-operations-console.md
# ---------------------------------------------------------------------------
# The scheduler's liveness marker. Read by three places that must never disagree:
# bootstrap/app.php (which writes it), App\Domain\Operations\Services\ProbeSchedulerStatus
# (which reports its age) and docker/php/scheduler-healthcheck.php (the container healthcheck).
# The scheduler beats into two places, because two audiences fail independently:
#   the FILE, read by the container's own healthcheck inside the scheduler container. Local on
#   purpose — a healthcheck that went red because Redis was down would restart a healthy scheduler.
OPERATIONS_HEARTBEAT_PATH=/tmp/scheduler-heartbeat
#   the CACHE KEY, read by the operations screen, which is rendered by the `app` container. `app`
#   and `scheduler` each get their own tmpfs at /tmp, so `app` cannot see the file above at all.
OPERATIONS_HEARTBEAT_CACHE_KEY=operations:scheduler-heartbeat
# Long enough that a stall's duration is still reportable: an expired key can only say "stalled".
OPERATIONS_HEARTBEAT_CACHE_TTL_SECONDS=86400
# Three missed minutes. One missed tick is a slow container, not an outage.
OPERATIONS_HEARTBEAT_MAX_AGE_SECONDS=180

# When each scheduled task runs. Timing lives here rather than in the database on purpose: a cron
# expression typed into a web form is how a job silently stops running forever (ADR 0015).
# Whether a task runs at all is the one runtime switch, held in `scheduled_tasks.enabled`.
OPERATIONS_SCHEDULE_TIMEZONE=Europe/Bucharest
# Weekdays at 14:00 Bucharest — BNR publishes the daily reference rates around midday.
OPERATIONS_CRON_FX_IMPORT_DAILY=0 14 * * 1-5

# Manual runs are dispatched here, never executed inside the HTTP request.
OPERATIONS_RUN_QUEUE=default
# Held while a run is in flight so a double-click cannot start two imports over the same day.
# Longer than the slowest task; self-expiring so a crashed worker cannot wedge a task permanently.
OPERATIONS_RUN_LOCK_SECONDS=1800
OPERATIONS_RUN_MAX_OUTPUT_BYTES=4000

# Freshness thresholds behind the "is this data current?" panel.
# Four days covers a Friday import followed by a Monday public holiday.
OPERATIONS_FX_MAX_AGE_DAYS=4
OPERATIONS_DOCUMENT_STUCK_AFTER_MINUTES=60

# BNR's yearly archives start in 2005; the upper bound is the current year, resolved at runtime.
OPERATIONS_FX_BACKFILL_MIN_YEAR=2005

# ---------------------------------------------------------------------------
# Wallet — term deposits (BLUEPRINT.md §6.4)
# ---------------------------------------------------------------------------
# The terms the "add deposit" form offers, in months. A deposit is bought as a length, and the
# maturity date is derived from it — gross interest is `principal x rate x days / denominator` and
# those days are counted from the opening date to the derived one, so this list is what stands
# between a person and a hand-typed date that is a day out.
WALLET_DEPOSIT_TERMS_MONTHS=1,3,6,9,12,24,36

# Applied to every new deposit and shown read-only on the form. Not a choice, because the convention
# comes from the bank's contract, and 360 instead of 365 as the denominator moves the interest by
# about 1.4% with nothing about the result looking wrong. ACTUAL/365 is usual for RON term deposits;
# a deposit whose contract says otherwise is still accepted by the API, which takes any convention.
WALLET_DEPOSIT_DEFAULT_DAY_COUNT=ACTUAL_365

# ---------------------------------------------------------------------------
# Legislation retrieval — local embedding model (BLUEPRINT.md §15.2)
# ---------------------------------------------------------------------------
# The model runs inside `python-api`, not through an external API. That is what lets this feature
# ship while docs/STATUS.md blocked item #3 (external provider, region, DPA) is still open: the
# corpus is public legislation, but the search queries that reach it may carry personal context,
# and self-hosting means neither leaves the machine.
#
# Off by default. An installation whose python-api image predates the embedding dependencies must
# keep failing loudly through UnconfiguredEmbeddingProvider rather than start throwing connection
# errors inside a chunk backfill because a default changed under it.
RETRIEVAL_EMBEDDING_ENABLED=false
RETRIEVAL_EMBEDDING_URL=http://python-api:8000
# Generous: the very first call downloads the weights and builds an ONNX session. Later calls are
# milliseconds.
RETRIEVAL_EMBEDDING_TIMEOUT_SECONDS=900
RETRIEVAL_EMBEDDING_BATCH_SIZE=32

# These three must agree, or vectors land in the wrong space:
#   RETRIEVAL_EMBEDDING_DIMENSION (Laravel's expectation)
#   EMBEDDING_DIMENSION           (what the model actually emits)
#   source_section_chunks.embedding's vector(N)  (a migration)
RETRIEVAL_EMBEDDING_MODEL=intfloat/multilingual-e5-small
RETRIEVAL_EMBEDDING_DIMENSION=384

# --- the model itself, inside python-api ---
EMBEDDING_MODEL_ID=intfloat/multilingual-e5-small
EMBEDDING_REVISION=main
EMBEDDING_DIMENSION=384
EMBEDDING_MAX_TOKENS=512
EMBEDDING_BATCH_SIZE=16
# 118 MB int8 build; needs AVX512-VNNI. On a host without it use model_O4.onnx (235 MB).
EMBEDDING_ONNX_FILE=model_qint8_avx512_vnni.onnx
# E5 mean-pools and wants these prefixes. A symmetric model (bge-m3) uses "cls" and empty prefixes.
EMBEDDING_POOLING=mean
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_PASSAGE_PREFIX="passage: "
# Download the weights at boot rather than on the first request.
EMBEDDING_WARM_ON_STARTUP=false

# ---------------------------------------------------------------------------
# A private AI endpoint (VPN or LAN)
# ---------------------------------------------------------------------------
# Such a host usually resolves only through this machine's /etc/hosts, which containers never read:
# the provider answers from a terminal and is unreachable from the app, with nothing in the error to
# explain why. Setting both halves publishes the mapping inside the app and queue containers.
# Leave unset for a provider with ordinary public DNS.
AI_ENDPOINT_HOST=
AI_ENDPOINT_IP=

# ---------------------------------------------------------------------------
# AI provider — how long, how much (docs/adr/0007-provider-agnostic-ai.md)
# ---------------------------------------------------------------------------
# Which provider, URL, model and key are *runtime settings*, edited in Administrare -> Setări
# sistem and stored in the database — not env vars, because an operator changes them without a
# deploy. What lives here is the shape of the requests: budgets and ceilings that protect the
# system rather than describe the provider.

# Bounds the settings screen's connection test: one token, answered in milliseconds. A provider
# slower than this is not usable interactively, which is exactly what the test decides.
AI_HTTP_TIMEOUT_SECONDS=10

# Bounds one document extraction, which is a different order of work — loading a vision model, then
# an image, then generating. Measured 32-56s against a self-hosted 8B vision model. Runs on a queue
# worker, so a long wait costs nobody a loading spinner. Reusing the ping's 10s here would abandon
# every real extraction and misreport the provider as unreachable.
AI_EXTRACTION_TIMEOUT_SECONDS=120

# A ceiling on the *reply*, not a target: a model answering properly emits a hundred tokens of JSON
# and stops. Sized for a reasoning model, which spends the same budget thinking first — at 1024,
# `qwen3-vl:8b-thinking` used the entire allowance on its chain of thought and returned an empty
# answer, which is indistinguishable from a model that could not read the document.
AI_EXTRACTION_MAX_TOKENS=4096

# The largest document sent for a model to look at. Below the 15 MB an upload may be: base64 adds a
# third on top, and a gateway's own body limit is usually smaller than either. A document over this
# is not truncated — half a receipt is not a smaller receipt — it is reported as a failed extraction
# and typed in by hand.
AI_EXTRACTION_MAX_IMAGE_BYTES=8388608

# Anthropic pins its API version in a header; every other dialect ignores this.
AI_ANTHROPIC_VERSION=2023-06-01
