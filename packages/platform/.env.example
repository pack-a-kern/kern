# ===========================================================================
# kern/platform — encryption, identity, access, AI provider
# ===========================================================================
# Every value in force is written here rather than left to a default in the config file. The few
# variables with no value are the ones only this installation can answer: without them the
# application refuses to start or fails at the point of use, never guesses.
#
# `php artisan kern:env` collects this file with the application's and every other package's.

# --- keys: mandatory, no default anywhere -------------------------------------------------------
# The global versioned HMAC key behind every exact-match lookup on an encrypted column — signing in
# by e-mail, finding the record that already holds an identifier. Without it any such lookup throws,
# registration and login included.
#   generate: php -r 'echo json_encode(["1" => base64_encode(random_bytes(32))]), PHP_EOL;'
# Versioned because a key is replaced by adding the next one and moving the pointer: rows hashed
# under version 1 keep matching while new rows are written under version 2.
CRYPTO_BLIND_INDEX_KEYS=
CRYPTO_BLIND_INDEX_CURRENT_VERSION=1

# The token the key-management service is reached with. Each tenant's data key is wrapped by a key
# that never leaves that service, so nothing can be decrypted without this.
#
# With the bundled container this is also the token it *issues* to the application at startup, scoped
# to the four transit paths this package calls — encrypt, decrypt, read the key, rotate it — and
# nothing else. It is not that server's root token: that one is generated at first boot and stays
# inside the `openbao_data` volume, used only by the container's own startup script. Against a
# key-management service you already run, create a token with the same four capabilities and put it
# here.
OPENBAO_TOKEN=

# --- key management -----------------------------------------------------------------------------
# Where that service answers. No default: a container name is a guess about someone else's network,
# and a wrong address should say so rather than be assumed.
OPENBAO_ADDR=http://openbao:8200
# `openbao` is the only driver shipped; an in-memory double stands in for it in tests, never in a
# running installation.
CRYPTO_KMS_DRIVER=openbao
# Where the wrapping keys live inside that service, and the name of the key each tenant's data key is
# wrapped by. Changing either after data exists strands what is already wrapped — and so does losing
# the key itself: a kernel panic on 2026-09-28 restarted an in-memory key server, and every value
# encrypted under it became permanently unreadable. The bundled container stores its keys on a volume
# for that reason; anything you point this at must do the same.
OPENBAO_TRANSIT_MOUNT=transit
OPENBAO_TAX_SUBJECT_KEK_NAME=tax-subject-kek
# Short on purpose: an unwrap happens inside a request, so a service that is not answering must fail
# fast and visibly rather than hold the request open.
OPENBAO_TIMEOUT_SECONDS=5

# --- email verification -------------------------------------------------------------------------
# Whether an account must prove it can read its own address before it may use the application. Off
# here, and the switch an administrator sees (`identity.email_verification_required`) falls back to
# this until somebody saves a value. Turning it on holds *every* unverified account at the
# verification screen — there is no backfill, because an address having been typed at registration is
# not evidence anybody could read it. If mail is misconfigured while it is on, nobody can get in at
# all: `php artisan kern:identity:verify-email <address>` is the way back.
IDENTITY_EMAIL_VERIFICATION_REQUIRED=false
# Digits in the code, how long one lives, and how many times it may be guessed at before it is dead.
# Short on purpose: the attempt ceiling is what makes a six-digit code safe, not its length, and a
# longer one only costs a person accuracy. The ceiling is a column rather than a rate limit, so
# clearing the cache does not hand anybody a fresh budget.
IDENTITY_VERIFICATION_CODE_LENGTH=6
IDENTITY_VERIFICATION_TTL_SECONDS=600
IDENTITY_VERIFICATION_MAX_ATTEMPTS=5

# --- routes -------------------------------------------------------------------------------------
# Where the packages mount the JSON routes they ship. The application sets it — named here only
# because this package's config reads it, and left unset so there is one definition, not two.
# KERN_ROUTE_PREFIX=

# --- identity -----------------------------------------------------------------------------------
# How long a half-finished sign-in — password accepted, second factor not yet given — stays open.
IDENTITY_MFA_PENDING_TTL_SECONDS=300
# Whether strangers may create accounts. Only the starting value: an owner changes it from
# Administrare -> Setări sistem and that choice wins. An instance with no users accepts the first
# registration either way, so a fresh deployment cannot lock itself out.
REGISTRATION_ENABLED=true

# --- passkeys -----------------------------------------------------------------------------------
# A passkey is bound to one host, by design — that binding is what makes it unphishable, and it
# cannot be changed afterwards. The relying party is named APP_NAME and identified by APP_URL's host,
# both set by the application; with either missing, registering a passkey refuses outright rather
# than binding the credential to somewhere this application is not served from.
#
# Both are the application's own and are set there; named here because this package's config reads
# them, and because this is where the consequence of leaving them unset is written down.
# APP_NAME=
# APP_URL=
#
# Set WEBAUTHN_RP_ID only when the application is served from a subdomain but passkeys must work
# across the parent (`example.com` for `app.example.com`). It must be a registrable suffix of the
# page's own host or every browser refuses the credential.
# WEBAUTHN_RP_ID=
# The origins a passkey may be used from, comma-separated. Defaults to APP_URL, which is wrong the
# moment the application is reached at a second address — a LAN IP as well as a name, say.
# WEBAUTHN_ALLOWED_ORIGINS=
# How long the browser is given to answer, and how long the server keeps the challenge. The server's
# must outlast the browser's, or someone who took their time gets an error instead of a refusal.
WEBAUTHN_TIMEOUT_MS=60000
WEBAUTHN_CHALLENGE_TTL_SECONDS=120

# --- the AI provider ----------------------------------------------------------------------------
# Which provider, URL, model and key are runtime settings, edited in Administrare -> Setări sistem
# and stored in the database, encrypted. These four are only the starting point, consulted for a
# field that has never been saved there.
AI_ENABLED=false
AI_PROVIDER=
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
# Anthropic pins its API version in a header; every other dialect ignores this.
AI_ANTHROPIC_VERSION=2023-06-01
# Bounds the settings screen's connection test: one token, answered in milliseconds. A provider
# slower than this is not usable interactively, which is exactly what the test decides.
AI_HTTP_TIMEOUT_SECONDS=10
# Every model call runs on a queue. The margin is how much longer the worker is allowed than the HTTP
# call it makes, so a timeout is reported by the call rather than by the worker being killed.
AI_QUEUE=documents-ai
AI_JOB_TIMEOUT_MARGIN_SECONDS=60
# Whether the provider can convert a document to another format, and improve text it has produced.
# Capabilities of the endpoint, not preferences: a provider that cannot do one is not asked.
AI_SUPPORTS_CONVERSION=false
AI_SUPPORTS_ENHANCEMENT=false
