# ===========================================================================
# kern/tax-romania — the Romanian product: subjects, SPV, statements, schedule
# ===========================================================================
# Every value in force is written here rather than left to a default in the config file. The few with
# no value are credentials, or things only this installation can answer.
#
# `php artisan kern:env` collects this file with the application's and every other package's.

# --- tax subjects -------------------------------------------------------------------------------
# The country a new subject is assumed to be in, and how many subjects each role may hold — the
# limits are what stops one account being used as an unbilled accounting practice.
SUBJECTS_DEFAULT_COUNTRY=RO
SUBJECTS_LIMIT_DEFAULT=1
SUBJECTS_LIMIT_VIEWER=1
SUBJECTS_LIMIT_ACCOUNTANT=50
SUBJECTS_LIMIT_ADMIN=100
SUBJECTS_LIMIT_SUPER_ADMIN=1000

# --- fiscal parameters --------------------------------------------------------------------------
# The law the values are read from, the currency they are in, how long one reading holds its lock
# so two runs cannot write the same year twice, and whose calendar a deadline the law sets falls on.
FISCAL_PARAMETERS_LAW="LEGE 227/2015"
FISCAL_PARAMETERS_CURRENCY=RON
FISCAL_PARAMETERS_LOCK_SECONDS=900
FISCAL_PARAMETERS_TIMEZONE=Europe/Bucharest

# --- ANAF's SPV ---------------------------------------------------------------------------------
# The web service, and the client certificate that identifies this installation to it. The
# certificate is the credential: a path to a file the container can read, and its password.
ANAF_SPV_WEBSERVICE_BASE_URL=https://webserviced.anaf.ro/SPVWS2/rest
ANAF_SPV_WEBSERVICE_TIMEOUT_SECONDS=30
# How far back a message list is asked for; the service answers a window, not everything.
ANAF_SPV_WEBSERVICE_MESSAGES_WINDOW_DAYS=60
ANAF_SPV_CLIENT_CERTIFICATE_PATH=
ANAF_SPV_CLIENT_CERTIFICATE_PASSWORD=

# The browser worker that signs in to SPV for what the web service does not expose. No default for
# the address — it is a fact about your network. The token must equal the worker's own; empty fails
# closed on both sides rather than allowing an unauthenticated call.
# Where the browser worker is reachable. No default in config — a hostname belongs to the
# installation, not to this package. Empty with the bundled worker: compose.services/browser.yaml sets
# its https:// address and the stack's CA. For one you run elsewhere, its https:// address, and
# BROWSER_WORKER_CA_CERT only if its certificate is signed by a private CA, as a path inside the
# containers.
BROWSER_WORKER_URL=
BROWSER_WORKER_CA_CERT=
# The shared secret the worker checks on every request, and this application sends. `make install`
# generates it for a worker installed here; for one you run elsewhere, it is that worker's. Empty, the
# worker refuses every request and `kern:health` reports it down. (Its BROWSER_AUTH_MODE=network,
# which needs no token, is a decision for a deployment to write down, never the default.)
BROWSER_WORKER_TOKEN=
BROWSER_WORKER_TIMEOUT_SECONDS=120
# How long a sign-in challenge waits for the person to approve it on their device.
# The timezone ANAF's own screens render dates in. The portal prints "15.09.2026 20:49:40" with no
# offset, and reading that as UTC files a document shown late on 31 December in the following tax year.
# Here because it is a statement about a remote system that could turn out to be wrong, not because an
# installation would want a different answer.
SPV_PORTAL_TIMEZONE=Europe/Bucharest
SPV_CHALLENGE_TTL_SECONDS=300

# --- bank statements ----------------------------------------------------------------------------
# What a statement may be, and how it is taken in. 10 MiB; a current account's five years is
# comfortably under the row ceiling the processing service enforces.
STATEMENT_IMPORT_MAX_FILE_BYTES=10485760
# One database write while committing, and how much the review screen shows before anything is.
STATEMENT_IMPORT_COMMIT_CHUNK=500
STATEMENT_IMPORT_PREVIEW_ROWS=20
STATEMENT_IMPORT_PREVIEW_TRANSACTIONS=3
STATEMENT_IMPORT_MAX_TAGS_PER_ROW=3
# Asking the model again (for the columns or for the rows) per taxpayer per window — each ask is a
# round of calls to a provider that may bill for them.
STATEMENT_IMPORT_MODEL_RATE_LIMIT_MAX_ATTEMPTS=10
STATEMENT_IMPORT_MODEL_RATE_LIMIT_DECAY_SECONDS=60
# An uploaded statement is scanned before it is read: how many times the verdict is checked, and how
# long between checks.
STATEMENT_IMPORT_SCAN_WAIT_CHECKS=20
STATEMENT_IMPORT_SCAN_WAIT_SECONDS=15
# Parsing runs in the processing service: how long one parse may take, and the pauses before a parse
# that did not answer is tried again.
STATEMENT_PARSE_TIMEOUT_SECONDS=120
STATEMENT_PARSE_RETRY_SECONDS=10,30,60,120,300
# Below this share of recognised columns the file is parsed in the request instead of on a queue —
# waiting for a worker to pick up twenty rows is slower than doing it.
STATEMENT_IMPORT_PARSE_THRESHOLD=0.95

# --- what a model does with a statement ---------------------------------------------------------
# Two calls, two jobs: mapping a statement's columns, and suggesting a category and tags for its
# counterparties. No default for either model — a model name is a fact about the endpoint you point
# at. One reading a header, one reading hundreds of rows, hence the different budgets.
STATEMENT_IMPORT_AI_MODEL=gpt-oss:20b
STATEMENT_IMPORT_AI_MAX_TOKENS=12000
STATEMENT_IMPORT_AI_TIMEOUT_SECONDS=600
# Whether counterparties are put to a model at all. Off, the rows are still staged, still filled in
# from earlier decisions, and still answerable by hand — the calls simply do not happen.
STATEMENT_IMPORT_CLASSIFICATION_ENABLED=true
STATEMENT_IMPORT_CLASSIFICATION_MODEL=gpt-oss:20b
STATEMENT_IMPORT_CLASSIFICATION_MAX_TOKENS=32000
STATEMENT_IMPORT_CLASSIFICATION_BATCH=100
# How many distinct statement lines one counterparty sends with its name. Most counterparties have
# one; the cap is for a supermarket that prints a different branch on every line, where the extra
# lines say nothing the first already said.
STATEMENT_IMPORT_CLASSIFICATION_MAX_DESCRIPTIONS=5
# A PDF converted to a table by the provider before it is read: the format asked for, the name the
# file travels under, and how long the conversion may take.
STATEMENT_IMPORT_CONVERSION_FORMAT=csv
STATEMENT_IMPORT_CONVERSION_FILENAME=statement.pdf
STATEMENT_IMPORT_CONVERSION_TIMEOUT_SECONDS=300

# --- the wallet ---------------------------------------------------------------------------------
# Applied to every new deposit and shown read-only: the convention comes from the bank's contract,
# and 360 instead of 365 moves the interest by about 1.4% with nothing about the result looking wrong.
WALLET_DEPOSIT_DEFAULT_DAY_COUNT=ACTUAL_365
# The terms the form offers, in months. A deposit is bought as a length and the maturity date is
# derived from it, so this list is what stands between a person and a hand-typed date a day out.
WALLET_DEPOSIT_TERMS_MONTHS=1,3,6,9,12,24,36
# Adding deposits from a CSV: the largest file read, in bytes, and the most deposits opened from one.
# The file is read in memory and never stored; all of its deposits are opened together or none is.
WALLET_DEPOSIT_IMPORT_MAX_FILE_BYTES=1048576
WALLET_DEPOSIT_IMPORT_MAX_ROWS=200

# --- banks --------------------------------------------------------------------------------------
# The list, and the backfill of banks that closed before the first import: the first month read, and
# how many days into each month to look for its first published list.
BANKS_COUNTRIES=RO
BANKS_CATEGORIES="Credit Institution"
BANKS_BACKFILL_FROM=2017-01
BANKS_BACKFILL_DAYS_TO_TRY=7
# Where bank logos are read from: one folder per country inside it, named by the bank's country
# code, and one file per bank named after its BIC (first eight characters) or LEI —
# <path>/RO/BTRLRO22.svg. SVG, WebP or PNG, up to 200 KB. Empty: storage/app/private/bank-logos.
BANKS_LOGOS_PATH=

# --- the scheduler and its tasks ----------------------------------------------------------------
# The liveness marker, written every minute and read in two places because two audiences fail
# independently: the FILE by the scheduler container's own healthcheck, which runs before the
# framework boots and reads this variable directly; the CACHE KEY by the operations screen, rendered
# in a different container that cannot see that file at all.
OPERATIONS_HEARTBEAT_PATH=/tmp/scheduler-heartbeat
OPERATIONS_HEARTBEAT_MAX_AGE_SECONDS=180
OPERATIONS_HEARTBEAT_CACHE_KEY=operations:scheduler-heartbeat
OPERATIONS_HEARTBEAT_CACHE_TTL_SECONDS=86400

# *When* each task runs. Timing lives here rather than in the database on purpose: a cron expression
# typed into a web form is how a job silently stops running forever. *Whether* it runs is the one
# runtime switch, held in `scheduled_tasks.enabled` and read on every tick.
# Weekdays at 14:00 Bucharest — BNR publishes the daily rates around midday.
OPERATIONS_SCHEDULE_TIMEZONE=Europe/Bucharest
OPERATIONS_CRON_FX_IMPORT_DAILY="0 14 * * 1-5"
OPERATIONS_CRON_BANKS_IMPORT="30 5 2 * *"
OPERATIONS_CRON_LEGISLATION_SYNC="0 3 * * 0"
# How often the counterparties nobody has answered are put to a model. Ten minutes, not one: nobody
# is waiting for the result — it is a proposal a person sees next time they open the ledger — and one
# call takes minutes rather than seconds.
OPERATIONS_CRON_COUNTERPARTIES_CLASSIFY="*/10 * * * *"
# Closing SPV sessions whose browser the worker has already expired, so a stale row stops claiming a
# sitting that no longer exists.
OPERATIONS_CRON_SPV_CLOSE_EXPIRED_SESSIONS=*/5 * * * *
# Removing the session rows whose session has expired, so the account page's device list stops
# offering to end devices that are already gone.
OPERATIONS_CRON_IDENTITY_PRUNE_SESSIONS="40 * * * *"
# Asking every service whether it answers, so administrators see a strip across the top when one stops.
OPERATIONS_CRON_SYSTEM_HEALTH_WATCH="*/5 * * * *"
# Telling owners about deposits nearing maturity — the hour the reminders arrive.
OPERATIONS_CRON_WALLET_MATURITY_REMINDERS="0 9 * * *"
# How many days before maturity they are told, once each; 0 is the day itself.
WALLET_DEPOSIT_REMINDER_DAYS=30,7,1,0
OPERATIONS_CRON_DEPOSIT_POST_INTEREST="15 0 * * *"

# A manual run is dispatched to a queue, never executed inside the request. The lock is held while a
# run is in flight so a double-click cannot start two imports over the same day; longer than the
# slowest task and self-expiring, so a crashed worker cannot wedge a task permanently.
OPERATIONS_RUN_QUEUE=default
OPERATIONS_RUN_LOCK_SECONDS=1800
OPERATIONS_RUN_MAX_OUTPUT_BYTES=4000

# The thresholds behind the "is this data current?" panel. Four days covers a Friday import followed
# by a Monday public holiday.
OPERATIONS_FX_MAX_AGE_DAYS=4
OPERATIONS_DOCUMENT_STUCK_AFTER_MINUTES=60
# BNR's yearly archives start in 2005; the upper bound is the current year, resolved at runtime.
OPERATIONS_FX_BACKFILL_MIN_YEAR=2005
# Which document types the legislation panel counts, and how long each component's health check may
# take before it is reported as not answering.
OPERATIONS_LEGISLATION_DOCUMENT_TYPES="LEGE,ORDONANTA,ORDONANTA DE URGENTA,HOTARARE,ORDIN,DECIZIE"
OPERATIONS_HEALTH_TIMEOUT_SECONDS=3

# --- what a model is told ------------------------------------------------------------------------
# Left unset: these are paragraphs, and they live in config/ai/statements.php where a sentence is
# reviewable in a diff rather than a single long line in an env file.
# STATEMENT_PROMPT_MAPPING_SYSTEM=
# STATEMENT_PROMPT_MAPPING_INSTRUCTION=
# STATEMENT_PROMPT_CLASSIFICATION_SYSTEM=
# STATEMENT_PROMPT_CLASSIFICATION_INSTRUCTION=
