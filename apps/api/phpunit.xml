        <env name="INVESTMENTS_PROCESSING_TIMEOUT_SECONDS" value="60" force="true"/>
        <env name="WALLET_HOLDINGS_MAX_AMOUNT_MINOR" value="100000000000000" force="true"/>
        <env name="OPERATIONS_CRON_HOLDINGS_POST_PAYOUTS" value="30 0 * * *" force="true"/>
        <env name="EMBEDDING_MODEL_ID" value="intfloat/multilingual-e5-small" force="true"/>
        <env name="EMBEDDING_DIMENSION" value="384" force="true"/>
        <env name="RETRIEVAL_EMBEDDING_ENABLED" value="false" force="true"/>
        <env name="RETRIEVAL_EMBEDDING_TIMEOUT_SECONDS" value="900" force="true"/>
        <env name="RETRIEVAL_EMBEDDING_BATCH_SIZE" value="32" force="true"/>
        <env name="LEGISLATION_AI_MODEL" value="test-reader" force="true"/>
        <env name="STATEMENT_IMPORT_AI_MODEL" value="test-mapper" force="true"/>
        <env name="STATEMENT_IMPORT_CLASSIFICATION_MODEL" value="test-classifier" force="true"/>
    </php>
</phpunit>
