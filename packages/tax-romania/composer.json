{
    "name": "kern/tax-romania",
    "description": "Romanian tax for an individual: the taxpayer, the values the law sets, the deterministic engine that applies them, and the wallet, statements, rentals, exchange rates and declarations a return is built from.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-bcmath": "*",
        "ext-intl": "*",
        "illuminate/bus": "^13.0",
        "illuminate/cache": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/filesystem": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "kern/audit": "@dev",
        "kern/documents": "@dev",
        "kern/legislation": "@dev",
        "kern/platform": "@dev"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.1"
    },
    "autoload": {
        "psr-4": {
            "Kern\\TaxRomania\\": "src/",
            "Kern\\TaxRomania\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kern\\TaxRomania\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Kern\\TaxRomania\\TaxRomaniaServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "repositories": [
        {
            "type": "path",
            "url": "../*",
            "options": {
                "symlink": true
            }
        }
    ]
}
