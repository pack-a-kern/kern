# ===========================================================================
# kern/investments — government bonds, listed shares and bonds, their payouts and prices
# ===========================================================================
# Every value is here and nowhere else: the config file has no defaults, and a value missing or
# malformed fails at first use, naming the variable.
#
# `php artisan kern:env` collects this file with the application's and every other package's.

# --- the Bucharest Stock Exchange (BVB) -------------------------------------------------------------
# Its home page, shown with the source on the official sources screen.
INVESTMENTS_BVB_BASE_URL=https://www.bvb.ro
# Its public pages, read once a trading day after the close; prices on them are 15 minutes late. https,
# on www.bvb.ro or bvb.ro — the hosts this package allows for BVB.
INVESTMENTS_BVB_SHARES_URL=https://www.bvb.ro/FinancialInstruments/Markets/Shares
INVESTMENTS_BVB_BONDS_URL=https://www.bvb.ro/FinancialInstruments/Markets/Bonds
INVESTMENTS_BVB_DIVIDENDS_URL=https://www.bvb.ro/FinancialInstruments/CorporateActions/InfoDividend
# One instrument's page: its issue, its shareholders' meetings and its shareholders. `{symbol}` is
# replaced by the instrument's symbol.
INVESTMENTS_BVB_INSTRUMENT_URL="https://www.bvb.ro/FinancialInstruments/Details/FinancialInstrumentsDetails.aspx?s={symbol}"
# After each day's import, a listed instrument's page — and, the first time, its past prices — is read in the
# background once its last reading is older than so many days (1 to 365; a person's own reading counts), one
# instrument every so many seconds (1 to 3600), so BVB is never asked for them all at once.
INVESTMENTS_BVB_PAGE_REFRESH_DAYS=7
INVESTMENTS_BVB_SPACING_SECONDS=30
# The time zone of the times those pages print beside a price.
INVESTMENTS_BVB_TIMEZONE=Europe/Bucharest

# --- the Ministry of Finance's orders, on legislatie.just.ro -------------------------------------------
# Watched by kern/legislation's law watches: each programme's orders searched by words of their title,
# year by year from the first, every so many hours; a title must match its pattern (a PCRE pattern, as
# /…/u) to be read as that programme's order. ORDIN is the act type kept.
INVESTMENTS_ORDERS_ACT_TYPE=ORDIN
INVESTMENTS_ORDERS_WATCH_HOURS=168
INVESTMENTS_FIDELIS_SEARCH="Programul FIDELIS"
INVESTMENTS_FIDELIS_FIRST_YEAR=2020
INVESTMENTS_FIDELIS_TITLE_PATTERN="/Programul FIDELIS/iu"
INVESTMENTS_TEZAUR_SEARCH="Programului Tezaur"
INVESTMENTS_TEZAUR_FIRST_YEAR=2018
INVESTMENTS_TEZAUR_TITLE_PATTERN="/în cadrul Programului Tezaur/iu"

# --- the Ministry of Finance's subscription lists -----------------------------------------------------
# The page that links both lists, and the pattern each list's link matches on it (the file names carry
# their update date). https, on a host the MF source allows.
INVESTMENTS_SUBSCRIPTIONS_PAGE_URL=https://mfinante.gov.ro/ro/web/trezor/subscrieri-realizate-prin-tezaur-%C8%99i-fidelis
INVESTMENTS_SUBSCRIPTIONS_FIDELIS_FILE=/FIDELIS[\w-]*\.xlsx/i
INVESTMENTS_SUBSCRIPTIONS_TEZAUR_FILE=/TEZAUR[\w-]*\.xlsx/i

# --- writing ----------------------------------------------------------------------------------------
# How many rows an import writes at once (1 to 5000).
INVESTMENTS_WRITE_CHUNK=500
# The queue BVB instrument pages (and an order's issues) are read on. Its own supervisor runs it one
# at a time (supervisor-investments-bvb) so browser reads never pile onto the browser worker at once.
INVESTMENTS_QUEUE=investments-bvb

# --- the read endpoints ------------------------------------------------------------------------------
# Rows a page holds at most (1 to 200), and the longest span of days one answer of prices or payouts
# covers (1 to 3660). Each person's budget of reads, and of company profiles read from BVB on request.
# A profile asked for again while younger than its refresh age (hours, 1 to 720) is the stored one.
INVESTMENTS_API_PAGE_SIZE=50
INVESTMENTS_API_MAX_SPAN_DAYS=1830
INVESTMENTS_API_READS_MAX_ATTEMPTS=120
INVESTMENTS_API_READS_DECAY_SECONDS=60
INVESTMENTS_API_REFRESHES_MAX_ATTEMPTS=10
INVESTMENTS_API_REFRESHES_DECAY_SECONDS=3600
INVESTMENTS_PROFILE_REFRESH_HOURS=24

# --- the processing service --------------------------------------------------------------------------
# How long it may take to turn one of the Ministry of Finance's spreadsheets into rows, in seconds
# (1 to 600). The spreadsheets are a few hundred rows.
INVESTMENTS_PROCESSING_TIMEOUT_SECONDS=60
