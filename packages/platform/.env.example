# ===========================================================================
# kern/platform — encryption, identity, access, AI provider
# ===========================================================================
# The two variables at the top have no default and the application will not run without them.
# Everything below them is read by the config file named above its group and already has a default
# there — which is why each is listed commented out, and why the default is not repeated here: the
# config file is the one place it is written down. Uncomment one only to change it.
#
# `php artisan kern:env` collects this file together with the application's and every other
# installed package's. tests/Feature/Config/ConfigKeysTest.php fails when this package's config
# reads a variable this file does not name.

# --- config/crypto.php — MANDATORY -----------------------------------------
# The global, versioned HMAC key behind every exact-match lookup on an encrypted column: signing in
# by e-mail, and finding the record that already holds an identifier. Without it the application
# throws on any such lookup — registration and login included.
#
# Format: a JSON object mapping version => base64-encoded 32-byte key.
# Generate: php -r 'echo json_encode(["1" => base64_encode(random_bytes(32))]), PHP_EOL;'
#
# Versioned because a key is replaced by adding the next one and moving the pointer below: rows
# hashed under version 1 keep matching while new rows are written under version 2.
CRYPTO_BLIND_INDEX_KEYS=
CRYPTO_BLIND_INDEX_CURRENT_VERSION=1

# The token the key-management service is reached with. Each tenant's data key is wrapped by a key
# that never leaves that service, so the application cannot decrypt anything without this.
#
# A dev OpenBao runs in-memory and accepts a root token chosen at startup, which is what this
# repository's compose file starts. A production deployment injects a scoped token from a secret
# manager and never writes one in a file.
OPENBAO_TOKEN=

# --- config/crypto.php -----------------------------------------------------
# Which key-management service, and where it answers. `openbao` is the only driver shipped; an
# in-memory double stands in for it in tests, never in a running installation.
# CRYPTO_KMS_DRIVER=
# OPENBAO_ADDR=
# Where the wrapping keys live inside that service: the transit mount, and the name of the key each
# tenant's data key is wrapped by. Changing either after data exists strands what is already wrapped.
# OPENBAO_TRANSIT_MOUNT=
# OPENBAO_TAX_SUBJECT_KEK_NAME=
# Short on purpose: an unwrap happens inside a request, so a service that is not answering must fail
# fast and visibly rather than hold the request open.
# OPENBAO_TIMEOUT_SECONDS=

# --- config/kern.php -------------------------------------------------------
# Where the packages mount the JSON routes they ship. The application sets it; it is named here
# because this package's own config reads it.
# KERN_ROUTE_PREFIX=

# --- config/identity.php ---------------------------------------------------
# How long a half-finished sign-in — password accepted, second factor not yet given — stays open.
# IDENTITY_MFA_PENDING_TTL_SECONDS=
# Whether strangers may create accounts. Only the starting value: an owner changes it from
# Administration -> Settings and that choice wins from then on. An instance with no users accepts the
# first registration either way, so a fresh deployment cannot lock itself out.
# REGISTRATION_ENABLED=

# --- config/webauthn.php ---------------------------------------------------
# A passkey is bound to one domain, by design: that binding is what makes it unphishable. Both are
# set by the application and named here because this package's config reads them — the relying party
# is named APP_NAME and identified by APP_URL's host.
# APP_NAME=
# APP_URL=
# Override the host only when the application is served from a subdomain but passkeys must work
# across the parent (`example.com` for `app.example.com`). It must be a registrable suffix of the
# page's own host or every browser refuses the credential.
# WEBAUTHN_RP_ID=
# The origins a passkey may be used from, comma-separated. Defaults to APP_URL, which is wrong the
# moment the application is reached at a second address — a LAN IP as well as a name, say.
# WEBAUTHN_ALLOWED_ORIGINS=
# How long the browser is given to answer a challenge, and how long the server keeps that challenge.
# The server's must outlast the browser's, or a person who took their time gets an error instead of a
# refusal.
# WEBAUTHN_TIMEOUT_MS=
# WEBAUTHN_CHALLENGE_TTL_SECONDS=

# --- config/ai/providers.php -----------------------------------------------
# Which provider, URL, model and key are *runtime settings*, edited in Administration -> System
# settings and stored in the database, encrypted. These are only the starting point, consulted for a
# field that has never been saved there.
# AI_ENABLED=
# AI_PROVIDER=
# AI_BASE_URL=
# AI_MODEL=
# AI_API_KEY=
# What follows is the shape of the requests: budgets and ceilings that protect the system rather
# than describe the provider.
# Anthropic pins its API version in a header; every other dialect ignores this.
# AI_ANTHROPIC_VERSION=
# Bounds the settings screen's connection test: one token, answered in milliseconds. A provider
# slower than this is not usable interactively, which is exactly what the test decides.
# AI_HTTP_TIMEOUT_SECONDS=
# Every model call runs on a queue. The margin is how much longer the worker is allowed than the
# HTTP call it makes, so a timeout is reported by the call rather than by the worker being killed.
# AI_QUEUE=
# AI_JOB_TIMEOUT_MARGIN_SECONDS=
# Whether this provider can be asked to convert a document to another format, and whether it can be
# asked to improve text it has already produced. Both are provider capabilities, not preferences: a
# provider that cannot do one is not asked.
# AI_SUPPORTS_CONVERSION=
# AI_SUPPORTS_ENHANCEMENT=
